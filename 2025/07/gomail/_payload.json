[{"data":1,"prerenderedAt":115},["ShallowReactive",2],{"content:\u002F2025\u002F07\u002Fgomail":3,"surround:\u002F2025\u002F07\u002Fgomail":104},{"id":4,"title":5,"body":6,"categories":79,"date":81,"description":82,"draft":83,"extension":84,"image":85,"meta":86,"navigation":88,"path":89,"permalink":85,"published":85,"readingTime":90,"recommend":85,"references":85,"seo":95,"sitemap":96,"stem":97,"tags":98,"type":101,"updated":102,"__hash__":103},"content\u002Fposts\u002F2025\u002F07\u002Fgomail.md","Go 使用 Gomail 发送邮件",{"type":7,"value":8,"toc":73},"minimark",[9,16,19,41,45,56,59,62,70],[10,11,12],"blockquote",{},[13,14,15],"p",{},"Gomail是是一款简单高效的邮件发送工具，可用于发送文本，图像，word，pdf等多种复杂格式，并且基于smtp服务器",[13,17,18],{},"Gomail 支持：",[20,21,22,26,29,32,35,38],"ul",{},[23,24,25],"li",{},"附件",[23,27,28],{},"嵌入图像",[23,30,31],{},"HTML 和文本模板",[23,33,34],{},"特殊字符的自动编码",[23,36,37],{},"SSL 和 TLS",[23,39,40],{},"使用同一个 smtp 连接发送多封电子邮件",[42,43,44],"h2",{"id":44},"安装",[46,47,53],"pre",{"className":48,"code":50,"language":51,"meta":52},[49],"language-bash","go get gopkg.in\u002Fgomail.v2\n","bash","",[54,55,50],"code",{"__ignoreMap":52},[42,57,58],{"id":58},"示例",[13,60,61],{},"下面是以发送qq邮件为示例",[46,63,68],{"className":64,"code":66,"language":67,"meta":52},[65],"language-go","func SendEmail(from string, to string, text string, smtpHost string, smtpPort int, secretKey string) {\n\tm := gomail.NewMessage()\n\tm.SetHeader(\"From\", from)\n\tm.SetHeader(\"To\", to)\n\tm.SetBody(\"text\u002Fplain\", text)\n\n\t\u002F\u002F 连接smtp服务器\n\td := gomail.NewDialer(smtpHost, smtpPort, from, secretKey)\n\n\t\u002F\u002F 发送邮件\n\tif err := d.DialAndSend(m); err != nil {\n\t\tfmt.Println(\"发送邮件失败\", err.Error())\n\t\treturn\n\t}\n\tfmt.Println(\"发送邮件成功\")\n}\n","go",[54,69,66],{"__ignoreMap":52},[13,71,72],{},"希望这对你有帮助",{"title":52,"searchDepth":74,"depth":74,"links":75},4,[76,78],{"id":44,"depth":77,"text":44},2,{"id":58,"depth":77,"text":58},[80],"Go语言","2025-07-28","gomail是是一款简单高效的邮件发送工具，可用于发送文本，图像，word，pdf等多种复杂格式，并且基于smtp服务器",false,"md",null,{"slots":87},{},true,"\u002F2025\u002F07\u002Fgomail",{"text":91,"minutes":92,"time":93,"words":94},"1 min read",0.885,53100,177,{"title":5,"description":82},{"loc":89},"posts\u002F2025\u002F07\u002Fgomail",[99,100],"Go","邮件发送","tech","2025-12-02","a55wzO9lUUjF48wB8aJc0OjkpVcTMvX_a1tNuYN24cw",[105,110],{"title":106,"path":107,"stem":108,"date":109,"type":101,"children":-1},"Go Wire 依赖注入实践","\u002F2025\u002F07\u002Fgo-wire","posts\u002F2025\u002F07\u002Fgo-wire","2025-07-26",{"title":111,"path":112,"stem":113,"date":114,"type":101,"children":-1},"Go 使用 MinIO SDK 上传文件","\u002F2025\u002F07\u002Fgo-minio","posts\u002F2025\u002F07\u002Fgo-minio","2025-07-31",1786037981379]