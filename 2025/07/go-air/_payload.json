[{"data":1,"prerenderedAt":173},["ShallowReactive",2],{"content:\u002F2025\u002F07\u002Fgo-air":3,"surround:\u002F2025\u002F07\u002Fgo-air":168},{"id":4,"title":5,"body":6,"categories":143,"date":145,"description":146,"draft":147,"extension":148,"image":149,"meta":150,"navigation":152,"path":153,"permalink":149,"published":149,"readingTime":154,"recommend":149,"references":149,"seo":159,"sitemap":160,"stem":161,"tags":162,"type":165,"updated":166,"__hash__":167},"content\u002Fposts\u002F2025\u002F07\u002Fgo-air.md","Go Air 热重载工具使用指南",{"type":7,"value":8,"toc":128},"minimark",[9,32,36,51,61,64,68,74,80,83,87,95,98,104,107,113,116,122],[10,11,12,13,17,18,21,22,25,26,28,29,31],"p",{},"用",[14,15,16],"code",{"code":16},"fresh","用腻了，想使用",[14,19,20],{"code":20},"air","尝尝鲜，上",[14,23,24],{"code":24},"Github","一看，",[14,27,20],{"code":20},"的知名度比",[14,30,16],{"code":16},"高很多，于是直接开始吧。",[33,34,35],"h2",{"id":35},"直接安装",[37,38,39],"blockquote",{},[10,40,41],{},[42,43,44,45],"strong",{},"项目地址：",[46,47,48],"a",{"href":48,"rel":49},"https:\u002F\u002Fgithub.com\u002Fair-verse\u002Fair",[50],"nofollow",[52,53,59],"pre",{"className":54,"code":56,"language":57,"meta":58},[55],"language-bash","go install github.com\u002Fair-verse\u002Fair@latest\n","bash","",[14,60,56],{"__ignoreMap":58},[33,62,63],{"id":63},"开始使用",[65,66,67],"h3",{"id":67},"初始化",[52,69,72],{"className":70,"code":71,"language":57,"meta":58},[55],"air init\n",[14,73,71],{"__ignoreMap":58},[10,75,76,77],{},"然后项目根目录就会多出一个",[14,78,79],{"code":79},".air.toml",[65,81,82],{"id":82},"修改配置文件",[84,85,86],"h4",{"id":86},"编译位置",[52,88,93],{"className":89,"code":91,"language":92,"meta":58},[90],"language-toml","cmd = \"go build -o .\u002Ftmp\u002Fmain.exe .\u002Fcmd\u002F.\" # 根据main.go所在位置修改，如果为根目录设置为'.',当前main.go位于cmd文件夹中\n","toml",[14,94,91],{"__ignoreMap":58},[84,96,97],{"id":97},"退出air删除exe",[52,99,102],{"className":100,"code":101,"language":92,"meta":58},[90],"[misc]\n  clean_on_exit = true # 在退出air的时候删除编译的exe\n",[14,103,101],{"__ignoreMap":58},[84,105,106],{"id":106},"完整配置文件",[52,108,111],{"className":109,"code":110,"language":92,"meta":58},[90],"root = \".\"\ntestdata_dir = \"testdata\"\ntmp_dir = \"tmp\"\n\n[build]\n  args_bin = []\n  bin = \"tmp\\\\main.exe\"\n  cmd = \"go build -o .\u002Ftmp\u002Fmain.exe .\u002Fcmd\u002F.\" # 根据main.go所在位置修改，如果为根目录设置为'.',当前main.go位于cmd文件夹中\n  delay = 1000\n  exclude_dir = [\"assets\", \"tmp\", \"vendor\", \"testdata\"]\n  exclude_file = []\n  exclude_regex = [\"_test.go\"]\n  exclude_unchanged = false\n  follow_symlink = false\n  full_bin = \"\"\n  include_dir = []\n  include_ext = [\"go\", \"tpl\", \"tmpl\", \"html\"]\n  include_file = []\n  kill_delay = \"0s\"\n  log = \"build-errors.log\"\n  poll = false\n  poll_interval = 0\n  post_cmd = []\n  pre_cmd = []\n  rerun = false\n  rerun_delay = 500\n  send_interrupt = false\n  stop_on_error = false\n\n[color]\n  app = \"\"\n  build = \"yellow\"\n  main = \"magenta\"\n  runner = \"green\"\n  watcher = \"cyan\"\n\n[log]\n  main_only = false\n  time = false\n\n[misc]\n  clean_on_exit = true # 在退出air的时候删除编译的exe\n\n[proxy]\n  app_port = 0\n  enabled = false\n  proxy_port = 0\n\n[screen]\n  clear_on_rebuild = false\n  keep_scroll = true\n",[14,112,110],{"__ignoreMap":58},[65,114,115],{"id":115},"运行",[52,117,120],{"className":118,"code":119,"language":57,"meta":58},[55],"air # 默认直接读取.air.toml的配置\n",[14,121,119],{"__ignoreMap":58},[52,123,126],{"className":124,"code":125,"language":57,"meta":58},[55],"air -c config.toml # 指定配置文件\n",[14,127,125],{"__ignoreMap":58},{"title":58,"searchDepth":129,"depth":129,"links":130},4,[131,133],{"id":35,"depth":132,"text":35},2,{"id":63,"depth":132,"text":63,"children":134},[135,137,142],{"id":67,"depth":136,"text":67},3,{"id":82,"depth":136,"text":82,"children":138},[139,140,141],{"id":86,"depth":129,"text":86},{"id":97,"depth":129,"text":97},{"id":106,"depth":129,"text":106},{"id":115,"depth":136,"text":115},[144],"Go语言","2025-07-26","介绍 Go Air 热重载工具的安装、初始化和配置方法，提升本地开发与调试