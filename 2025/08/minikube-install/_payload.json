[{"data":1,"prerenderedAt":231},["ShallowReactive",2],{"content:\u002F2025\u002F08\u002Fminikube-install":3,"surround:\u002F2025\u002F08\u002Fminikube-install":221},{"id":4,"title":5,"body":6,"categories":196,"date":198,"description":199,"draft":200,"extension":201,"image":202,"meta":203,"navigation":205,"path":206,"permalink":202,"published":202,"readingTime":207,"recommend":202,"references":202,"seo":212,"sitemap":213,"stem":214,"tags":215,"type":218,"updated":219,"__hash__":220},"content\u002Fposts\u002F2025\u002F08\u002Fminikube-install.md","Minikube 安装与环境配置",{"type":7,"value":8,"toc":187},"minimark",[9,13,24,32,35,39,105,109,115,118,121,127,130,133,139,145,150,153,156,162,167,170,173,179,184],[10,11,12],"p",{},"升级一下系统",[14,15,21],"pre",{"className":16,"code":18,"language":19,"meta":20},[17],"language-bash","sudo apt update && sudo apt install -y curl wget apt-transport-https\n","bash","",[22,23,18],"code",{"__ignoreMap":20},[10,25,26],{},[27,28,29],"a",{"href":29,"rel":30},"https:\u002F\u002Fminikube.sigs.k8s.io\u002Fdocs\u002Fstart\u002F?arch=%2Flinux%2Fx86-64%2Fstable%2Fbinary+download",[31],"nofollow",[10,33,34],{},"因为用的是单节点的k8s",[36,37,38],"h2",{"id":38},"你需要什么",[40,41,42,46,49,52,55],"ul",{},[43,44,45],"li",{},"2 个或更多 CPU",[43,47,48],{},"2GB可用内存",[43,50,51],{},"20GB可用磁盘空间",[43,53,54],{},"互联网连接",[43,56,57,58,63,64,63,69,63,74,63,79,63,84,63,89,63,94,99,100],{},"容器或虚拟机管理器，例如：",[27,59,62],{"href":60,"rel":61},"https:\u002F\u002Fminikube.sigs.k8s.io\u002Fdocs\u002Fdrivers\u002Fdocker\u002F",[31],"Docker","、",[27,65,68],{"href":66,"rel":67},"https:\u002F\u002Fminikube.sigs.k8s.io\u002Fdocs\u002Fdrivers\u002Fqemu\u002F",[31],"QEMU",[27,70,73],{"href":71,"rel":72},"https:\u002F\u002Fminikube.sigs.k8s.io\u002Fdocs\u002Fdrivers\u002Fhyperkit\u002F",[31],"Hyperkit",[27,75,78],{"href":76,"rel":77},"https:\u002F\u002Fminikube.sigs.k8s.io\u002Fdocs\u002Fdrivers\u002Fhyperv\u002F",[31],"Hyper-V",[27,80,83],{"href":81,"rel":82},"https:\u002F\u002Fminikube.sigs.k8s.io\u002Fdocs\u002Fdrivers\u002Fkvm2\u002F",[31],"KVM",[27,85,88],{"href":86,"rel":87},"https:\u002F\u002Fminikube.sigs.k8s.io\u002Fdocs\u002Fdrivers\u002Fparallels\u002F",[31],"Parallels",[27,90,93],{"href":91,"rel":92},"https:\u002F\u002Fminikube.sigs.k8s.io\u002Fdocs\u002Fdrivers\u002Fpodman\u002F",[31],"Podman",[27,95,98],{"href":96,"rel":97},"https:\u002F\u002Fminikube.sigs.k8s.io\u002Fdocs\u002Fdrivers\u002Fvirtualbox\u002F",[31],"VirtualBox","或",[27,101,104],{"href":102,"rel":103},"https:\u002F\u002Fminikube.sigs.k8s.io\u002Fdocs\u002Fdrivers\u002Fvmware\u002F",[31],"VMware Fusion\u002FWorkstation",[36,106,108],{"id":107},"安装-minikube","安装 minikube：",[14,110,113],{"className":111,"code":112,"language":19,"meta":20},[17],"curl -LO https:\u002F\u002Fstorage.googleapis.com\u002Fminikube\u002Freleases\u002Flatest\u002Fminikube-linux-amd64\nsudo install minikube-linux-amd64 \u002Fusr\u002Flocal\u002Fbin\u002Fminikube\n",[22,114,112],{"__ignoreMap":20},[36,116,117],{"id":117},"启动集群",[10,119,120],{},"从具有管理员访问权限（但未以 root 身份登录）的终端运行：",[14,122,125],{"className":123,"code":124,"language":19,"meta":20},[17],"minikube start\n",[22,126,124],{"__ignoreMap":20},[10,128,129],{},"注意",[10,131,132],{},"不允许用 root 用户直接运行 docker 驱动",[10,134,135],{},[136,137],"img",{"alt":136,"src":138},"https:\u002F\u002Fcdn.jsdelivr.net\u002Fgh\u002Fcodepzj\u002Fimages@main\u002F20250821123630465.png",[14,140,143],{"className":141,"code":142,"language":19,"meta":20},[17],"sudo adduser k8s\nsudo usermod -aG sudo k8s # 分配root权限\nsudo usermod -aG docker k8s # 加入docker组，操控docker\nsudo usermod -aG docker k8s # 把用户加到docker组\nsu - k8s # 切换到新用户\n",[22,144,142],{"__ignoreMap":20},[10,146,147],{},[136,148],{"alt":136,"src":149},"https:\u002F\u002Fcdn.jsdelivr.net\u002Fgh\u002Fcodepzj\u002Fimages@main\u002F20250821123655108.png",[36,151,152],{"id":152},"启动minikube",[10,154,155],{},"一定要使用镜像，不然国内容易拉取失败",[14,157,160],{"className":158,"code":159,"language":19,"meta":20},[17],"minikube start --driver=docker --base-image=registry.cn-hangzhou.aliyuncs.com\u002Fgoogle_containers\u002Fkicbase:v0.0.47\n",[22,161,159],{"__ignoreMap":20},[10,163,164],{},[136,165],{"alt":136,"src":166},"https:\u002F\u002Fcdn.jsdelivr.net\u002Fgh\u002Fcodepzj\u002Fimages@main\u002F20250821123725881.png",[10,168,169],{},"拉取成功",[36,171,172],{"id":172},"安装kubectl",[14,174,177],{"className":175,"code":176,"language":19,"meta":20},[17]," curl -LO \"https:\u002F\u002Fdl.k8s.io\u002Frelease\u002F$(curl -L -s https:\u002F\u002Fdl.k8s.io\u002Frelease\u002Fstable.txt)\u002Fbin\u002Flinux\u002Famd64\u002Fkubectl\"\n",[22,178,176],{"__ignoreMap":20},[10,180,181],{},[136,182],{"alt":136,"src":183},"https:\u002F\u002Fcdn.jsdelivr.net\u002Fgh\u002Fcodepzj\u002Fimages@main\u002F20250821123746723.png",[10,185,186],{},"安装成功",{"title":20,"searchDepth":188,"depth":188,"links":189},4,[190,192,193,194,195],{"id":38,"depth":191,"text":38},2,{"id":107,"depth":191,"text":108},{"id":117,"depth":191,"text":117},{"id":152,"depth":191,"text":152},{"id":172,"depth":191,"text":172},[197],"云原生","2025-08-21","介绍在 Linux 环境安装 Minikube、配置 Docker 驱动、启动集群并安装 kubectl 的完整步骤。",false,"md",null,{"slots":204},{},true,"\u002F2025\u002F08\u002Fminikube-install",{"text":208,"minutes":209,"time":210,"words":211},"2 min read",1.07,64200,214,{"title":5,"description":199},{"loc":206},"posts\u002F2025\u002F08\u002Fminikube-install",[216,217],"Kubernetes","Minikube","tech","2026-06-20","J1z5nOIU0_kjDPrv5PwBVfPtA33vvQ5Nj9GU1cVEx-M",[222,226],{"title":223,"path":224,"stem":225,"date":198,"type":218,"children":-1},"Go Timer 与 Ticker 定时器详解","\u002F2025\u002F08\u002Fgo-timer","posts\u002F2025\u002F08\u002Fgo-timer",{"title":227,"path":228,"stem":229,"date":230,"type":218,"children":-1},"MySQL 常用数据类型详解","\u002F2025\u002F08\u002Fmysql-datastructure","posts\u002F2025\u002F08\u002Fmysql-datastructure","2025-08-26",1786037981188]