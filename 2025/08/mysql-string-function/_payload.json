[{"data":1,"prerenderedAt":423},["ShallowReactive",2],{"content:\u002F2025\u002F08\u002Fmysql-string-function":3,"surround:\u002F2025\u002F08\u002Fmysql-string-function":413},{"id":4,"title":5,"body":6,"categories":389,"date":391,"description":392,"draft":393,"extension":394,"image":395,"meta":396,"navigation":398,"path":399,"permalink":395,"published":395,"readingTime":400,"recommend":395,"references":395,"seo":405,"sitemap":406,"stem":407,"tags":408,"type":411,"updated":391,"__hash__":412},"content\u002Fposts\u002F2025\u002F08\u002Fmysql-string-function.md","MySQL 常用字符串函数",{"type":7,"value":8,"toc":383},"minimark",[9,356,360,364,374,377],[10,11,12,31],"table",{},[13,14,15],"thead",{},[16,17,18,22,25,28],"tr",{},[19,20,21],"th",{},"功能",[19,23,24],{},"函数",[19,26,27],{},"示例",[19,29,30],{},"结果",[32,33,34,54,72,90,108,126,144,162,180,197,214,232,250,266,284,302,320,338],"tbody",{},[16,35,36,40,46,51],{},[37,38,39],"td",{},"字符串长度（字节数）",[37,41,42],{},[43,44,45],"code",{"code":45},"LENGTH(str)",[37,47,48],{},[43,49,50],{"code":50},"LENGTH('Hello')",[37,52,53],{},"5",[16,55,56,59,64,69],{},[37,57,58],{},"字符串长度（字符数）",[37,60,61],{},[43,62,63],{"code":63},"CHAR_LENGTH(str)",[37,65,66],{},[43,67,68],{"code":68},"CHAR_LENGTH('你好')",[37,70,71],{},"2",[16,73,74,77,82,87],{},[37,75,76],{},"转大写",[37,78,79],{},[43,80,81],{"code":81},"UPPER(str)",[37,83,84],{},[43,85,86],{"code":86},"UPPER('hello')",[37,88,89],{},"HELLO",[16,91,92,95,100,105],{},[37,93,94],{},"转小写",[37,96,97],{},[43,98,99],{"code":99},"LOWER(str)",[37,101,102],{},[43,103,104],{"code":104},"LOWER('HELLO')",[37,106,107],{},"hello",[16,109,110,113,118,123],{},[37,111,112],{},"拼接",[37,114,115],{},[43,116,117],{"code":117},"CONCAT(s1, s2, …)",[37,119,120],{},[43,121,122],{"code":122},"CONCAT('Hello',' ','World')",[37,124,125],{},"Hello World",[16,127,128,131,136,141],{},[37,129,130],{},"拼接（带分隔符）",[37,132,133],{},[43,134,135],{"code":135},"CONCAT_WS(sep, s1, s2, …)",[37,137,138],{},[43,139,140],{"code":140},"CONCAT_WS('-', '2025','08','25')",[37,142,143],{},"2025-08-25",[16,145,146,149,154,159],{},[37,147,148],{},"截取字符串",[37,150,151],{},[43,152,153],{"code":153},"SUBSTRING(str, pos, len)",[37,155,156],{},[43,157,158],{"code":158},"SUBSTRING('Hello World', 7, 5)",[37,160,161],{},"World",[16,163,164,167,172,177],{},[37,165,166],{},"去除空格",[37,168,169],{},[43,170,171],{"code":171},"TRIM(str)",[37,173,174],{},[43,175,176],{"code":176},"TRIM(' hi ')",[37,178,179],{},"hi",[16,181,182,185,190,195],{},[37,183,184],{},"去左空格",[37,186,187],{},[43,188,189],{"code":189},"LTRIM(str)",[37,191,192],{},[43,193,194],{"code":194},"LTRIM(' hi')",[37,196,179],{},[16,198,199,202,207,212],{},[37,200,201],{},"去右空格",[37,203,204],{},[43,205,206],{"code":206},"RTRIM(str)",[37,208,209],{},[43,210,211],{"code":211},"RTRIM('hi ')",[37,213,179],{},[16,215,216,219,224,229],{},[37,217,218],{},"替换",[37,220,221],{},[43,222,223],{"code":223},"REPLACE(str, from, to)",[37,225,226],{},[43,227,228],{"code":228},"REPLACE('2025-08-25','-','\u002F')",[37,230,231],{},"2025\u002F08\u002F25",[16,233,234,237,242,247],{},[37,235,236],{},"查找位置",[37,238,239],{},[43,240,241],{"code":241},"LOCATE(substr, str)",[37,243,244],{},[43,245,246],{"code":246},"LOCATE('World','Hello World')",[37,248,249],{},"7",[16,251,252,254,259,264],{},[37,253,236],{},[37,255,256],{},[43,257,258],{"code":258},"INSTR(str, substr)",[37,260,261],{},[43,262,263],{"code":263},"INSTR('Hello World','World')",[37,265,249],{},[16,267,268,271,276,281],{},[37,269,270],{},"重复",[37,272,273],{},[43,274,275],{"code":275},"REPEAT(str, n)",[37,277,278],{},[43,279,280],{"code":280},"REPEAT('ab', 3)",[37,282,283],{},"ababab",[16,285,286,289,294,299],{},[37,287,288],{},"左填充",[37,290,291],{},[43,292,293],{"code":293},"LPAD(str, len, pad)",[37,295,296],{},[43,297,298],{"code":298},"LPAD('7', 3, '0')",[37,300,301],{},"007",[16,303,304,307,312,317],{},[37,305,306],{},"右填充",[37,308,309],{},[43,310,311],{"code":311},"RPAD(str, len, pad)",[37,313,314],{},[43,315,316],{"code":316},"RPAD('7', 3, '0')",[37,318,319],{},"700",[16,321,322,325,330,335],{},[37,323,324],{},"反转",[37,326,327],{},[43,328,329],{"code":329},"REVERSE(str)",[37,331,332],{},[43,333,334],{"code":334},"REVERSE('hello')",[37,336,337],{},"olleh",[16,339,340,343,348,353],{},[37,341,342],{},"分隔符截取",[37,344,345],{},[43,346,347],{"code":347},"SUBSTRING_INDEX(str, delim, count)",[37,349,350],{},[43,351,352],{"code":352},"SUBSTRING_INDEX('a,b,c', ',', -1)",[37,354,355],{},"c",[357,358,359],"p",{},"SQL 里的字符串函数非常常用，不同数据库有些差异（MySQL、PostgreSQL、SQL Server、Oracle 等语法略有不同），我先给你列常见的 MySQL 语法，绝大多数数据库都支持类似写法。",[361,362,363],"h2",{"id":363},"常用字符串函数",[365,366,372],"pre",{"className":367,"code":369,"language":370,"meta":371},[368],"language-sql","-- 获取字符串长度\nLENGTH('Hello');         -- 结果: 5 (字节数)\nCHAR_LENGTH('Hello');    -- 结果: 5 (字符数)\n\n-- 大小写转换\nUPPER('hello');          -- 结果: HELLO\nLOWER('HELLO');          -- 结果: hello\n\n-- 拼接字符串\nCONCAT('Hello', ' ', 'World');       -- 结果: Hello World\nCONCAT_WS('-', '2025', '08', '25');  -- 结果: 2025-08-25\n\n-- 截取字符串\nSUBSTRING('Hello World', 1, 5);      -- 结果: Hello\nSUBSTRING('Hello World', 7);         -- 结果: World\n\n-- 去除空格\nTRIM('   hello   ');    -- 结果: hello\nLTRIM('   hello');      -- 结果: hello\nRTRIM('hello   ');      -- 结果: hello\n\n-- 替换字符串\nREPLACE('2025-08-25', '-', '\u002F');     -- 结果: 2025\u002F08\u002F25\n\n-- 查找位置\nLOCATE('World', 'Hello World');      -- 结果: 7\nINSTR('Hello World', 'World');       -- 结果: 7\n\n-- 重复字符串\nREPEAT('abc', 3);       -- 结果: abcabcabc\n\n-- 左右填充\nLPAD('7', 3, '0');      -- 结果: 007\nRPAD('7', 3, '0');      -- 结果: 700\n\n-- 反转字符串\nREVERSE('hello');       -- 结果: olleh\n\n-- 提取指定分隔符字段\nSUBSTRING_INDEX('a,b,c', ',', 1);   -- 结果: a\nSUBSTRING_INDEX('a,b,c', ',', -1);  -- 结果: c\n","sql","",[43,373,369],{"__ignoreMap":371},[361,375,376],{"id":376},"实用示例",[365,378,381],{"className":379,"code":380,"language":370,"meta":371},[368],"-- 手机号脱敏\nSELECT CONCAT(LEFT('13812345678', 3), '****', RIGHT('13812345678', 4));\n-- 结果: 138****5678\n\n-- 统计邮箱后缀\nSELECT SUBSTRING_INDEX(email, '@', -1) AS domain, COUNT(*) \nFROM users \nGROUP BY domain;\n",[43,382,380],{"__ignoreMap":371},{"title":371,"searchDepth":384,"depth":384,"links":385},4,[386,388],{"id":363,"depth":387,"text":363},2,{"id":376,"depth":387,"text":376},[390],"数据库","2025-08-26","整理 MySQL 字符串拼接、截取、替换、长度计算和大小写转换等常用函数。",false,"md",null,{"slots":397},{},true,"\u002F2025\u002F08\u002Fmysql-string-function",{"text":401,"minutes":402,"time":403,"words":404},"3 min read",2.02,121200,404,{"title":5,"description":392},{"loc":399},"posts\u002F2025\u002F08\u002Fmysql-string-function",[409,410],"MySQL","SQL函数","tech","UySmxWVWYY1Sh2wA5h6WK2bnGhqPNgHCO9zEVV4xTAo",[414,418],{"title":415,"path":416,"stem":417,"date":391,"type":411,"children":-1},"SQL 语句分类：DDL、DML、DQL 与 DCL","\u002F2025\u002F08\u002Fmysql-sql-category","posts\u002F2025\u002F08\u002Fmysql-sql-category",{"title":419,"path":420,"stem":421,"date":422,"type":411,"children":-1},"MySQL 事务隔离级别详解","\u002F2025\u002F08\u002Fmysql-isolation-grade","posts\u002F2025\u002F08\u002Fmysql-isolation-grade","2025-08-28",1786037980980]