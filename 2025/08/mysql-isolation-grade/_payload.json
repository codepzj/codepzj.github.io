[{"data":1,"prerenderedAt":113},["ShallowReactive",2],{"content:\u002F2025\u002F08\u002Fmysql-isolation-grade":3,"surround:\u002F2025\u002F08\u002Fmysql-isolation-grade":103},{"id":4,"title":5,"body":6,"categories":79,"date":81,"description":82,"draft":83,"extension":84,"image":85,"meta":86,"navigation":88,"path":89,"permalink":85,"published":85,"readingTime":90,"recommend":85,"references":85,"seo":95,"sitemap":96,"stem":97,"tags":98,"type":101,"updated":81,"__hash__":102},"content\u002Fposts\u002F2025\u002F08\u002Fmysql-isolation-grade.md","MySQL 事务隔离级别详解",{"type":7,"value":8,"toc":73},"minimark",[9,13,36,39,47,58,61],[10,11,12],"h2",{"id":12},"并发事务出现的三种问题",[14,15,16,24,30],"ol",{},[17,18,19,23],"li",{},[20,21,22],"strong",{},"脏读（Dirty Read）","：事务A读取了事务B还未提交的数据，如果B回滚了，A读取的数据就是无效的。",[17,25,26,29],{},[20,27,28],{},"不可重复读（Non-Repeatable Read）","：事务A在同一个事务中两次读取同一行数据，结果不一致，这是因为事务B在中间修改并提交了这行数据。",[17,31,32,35],{},[20,33,34],{},"幻读（Phantom Read）","：事务A在同一个事务中两次执行相同条件的查询，发现结果集不一致。原因是事务B在中间插入或删除了符合条件的新数据。",[10,37,38],{"id":38},"事务的隔离级别",[40,41,42],"p",{},[43,44],"img",{"alt":45,"src":46},"image-20250828145920828","https:\u002F\u002Fcdn.jsdelivr.net\u002Fgh\u002Fcodepzj\u002Fimages@main\u002F20250828145923410.png",[48,49,55],"pre",{"className":50,"code":52,"language":53,"meta":54},[51],"language-sql","-- 设置当前会话的隔离级别\nSET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;\n\n-- 或设置全局默认隔离级别（需重启或重新连接生效）\nSET GLOBAL TRANSACTION ISOLATION LEVEL READ COMMITTED;\n","sql","",[56,57,52],"code",{"__ignoreMap":54},[40,59,60],{},"具体操作可看B站视频",[62,63,64],"ul",{},[17,65,66,67],{},"【黑马程序员 MySQL数据库入门到精通，从mysql安装到mysql高级、mysql优化全囊括】",[68,69,70],"a",{"href":70,"rel":71},"https:\u002F\u002Fwww.bilibili.com\u002Fvideo\u002FBV1Kr4y1i7ru?p=55&vd_source=717e5631051a8339c2eea7fb70959d5b",[72],"nofollow",{"title":54,"searchDepth":74,"depth":74,"links":75},4,[76,78],{"id":12,"depth":77,"text":12},2,{"id":38,"depth":77,"text":38},[80],"数据库","2025-08-28","介绍 MySQL 四种事务隔离级别、并发读写问题以及不同隔离级别之间的行为差异。",false,"md",null,{"slots":87},{},true,"\u002F2025\u002F08\u002Fmysql-isolation-grade",{"text":91,"minutes":92,"time":93,"words":94},"2 min read",1.24,74400,248,{"title":5,"description":82},{"loc":89},"posts\u002F2025\u002F08\u002Fmysql-isolation-grade",[99,100],"MySQL","数据库事务","tech","CAP25trJ38X2R-gDcIaP-FotgNjTjPtR7w1J1awskM8",[104,109],{"title":105,"path":106,"stem":107,"date":108,"type":101,"children":-1},"MySQL 常用字符串函数","\u002F2025\u002F08\u002Fmysql-string-function","posts\u002F2025\u002F08\u002Fmysql-string-function","2025-08-26",{"title":110,"path":111,"stem":112,"date":81,"type":101,"children":-1},"MySQL 事务的概念与特性","\u002F2025\u002F08\u002Fmysql-what-is-transaction","posts\u002F2025\u002F08\u002Fmysql-what-is-transaction",1786037980808]