[{"data":1,"prerenderedAt":76},["ShallowReactive",2],{"content:\u002F2025\u002F08\u002Fgo-channel2":3,"surround:\u002F2025\u002F08\u002Fgo-channel2":67},{"id":4,"title":5,"body":6,"categories":44,"date":46,"description":47,"draft":48,"extension":49,"image":50,"meta":51,"navigation":53,"path":54,"permalink":50,"published":50,"readingTime":55,"recommend":50,"references":50,"seo":60,"sitemap":61,"stem":62,"tags":63,"type":65,"updated":46,"__hash__":66},"content\u002Fposts\u002F2025\u002F08\u002Fgo-channel2.md","缓冲区为 1 和无缓冲区的 channel 有什么区别",{"type":7,"value":8,"toc":38},"minimark",[9,14,25,28,34],[10,11,13],"h3",{"id":12},"缓冲区为-1","缓冲区为 1",[15,16,22],"pre",{"className":17,"code":19,"language":20,"meta":21},[18],"language-go","package main\n\nimport \"fmt\"\n\nfunc main() {\n\tch := make(chan int, 1)\n\n\tch \u003C- 1\n\n\tfmt.Println(\"ch中的值为\", \u003C-ch)\n}\n","go","",[23,24,19],"code",{"__ignoreMap":21},[10,26,27],{"id":27},"无缓冲区",[15,29,32],{"className":30,"code":31,"language":20,"meta":21},[18],"package main\n\nimport \"fmt\"\n\nfunc main() {\n\tch := make(chan int)\n\n\tch \u003C- 1\n\n\tfmt.Println(\"ch中的值为\", \u003C-ch)\n}\n",[23,33,31],{"__ignoreMap":21},[35,36,37],"p",{},"缓冲区为 1 能正常输出 1\n而无缓冲区会死锁，因为在往 channel 置入值，当前 goroutine 就会被挂起，消费者无法接收 channel 传入的值",{"title":21,"searchDepth":39,"depth":39,"links":40},4,[41,43],{"id":12,"depth":42,"text":13},3,{"id":27,"depth":42,"text":27},[45],"Go语言","2025-08-04","带缓冲区的 channel（如容量为 1）允许发送方先发送后接收，不会立即阻塞；而无缓冲区的 channel 发送操作会阻塞当前 goroutine，直到有接收方同步接收，否则会造成死锁。因此缓冲区提供了发送和接收的解耦能力。",false,"md",null,{"slots":52},{},true,"\u002F2025\u002F08\u002Fgo-channel2",{"text":56,"minutes":57,"time":58,"words":59},"1 min read",0.49,29400,98,{"title":5,"description":47},{"loc":54},"posts\u002F2025\u002F08\u002Fgo-channel2",[64],"channel","tech","qZInLyth3egQ3tW0QLuXVZ9--TyjXWrPaXTVaa7p3H8",[68,72],{"title":69,"path":70,"stem":71,"date":46,"type":65,"children":-1},"Go Channel 基础概念与用法","\u002F2025\u002F08\u002Fgo-channel1","posts\u002F2025\u002F08\u002Fgo-channel1",{"title":73,"path":74,"stem":75,"date":46,"type":65,"children":-1},"Go Channel 生产者消费者模型","\u002F2025\u002F08\u002Fgo-channel3","posts\u002F2025\u002F08\u002Fgo-channel3",1786037981312]