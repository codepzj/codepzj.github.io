[{"data":1,"prerenderedAt":106},["ShallowReactive",2],{"content:\u002F2025\u002F08\u002Fmysql-what-is-transaction":3,"surround:\u002F2025\u002F08\u002Fmysql-what-is-transaction":96},{"id":4,"title":5,"body":6,"categories":72,"date":74,"description":75,"draft":76,"extension":77,"image":78,"meta":79,"navigation":81,"path":82,"permalink":78,"published":78,"readingTime":83,"recommend":78,"references":78,"seo":88,"sitemap":89,"stem":90,"tags":91,"type":94,"updated":74,"__hash__":95},"content\u002Fposts\u002F2025\u002F08\u002Fmysql-what-is-transaction.md","MySQL 事务的概念与特性",{"type":7,"value":8,"toc":66},"minimark",[9,13,17,25,31,37,43,49,52,59],[10,11,12],"h2",{"id":12},"什么是事务",[14,15,16],"p",{},"事务是控制数据库操作的一段逻辑，要么全部成功，要么全部失败",[14,18,19,20,24],{},"具有",[21,22,23],"code",{"code":23},"ACID","的特性",[14,26,27,30],{},[21,28,29],{"code":29},"A","：原子性，要么全部成功，要么全部失败",[14,32,33,36],{},[21,34,35],{"code":35},"C","：一致性，保证事务前后数据相加一致",[14,38,39,42],{},[21,40,41],{"code":41},"I",": 隔离性，多个并发事务执行中互不干扰，也与数据库的隔离级别有关",[14,44,45,48],{},[21,46,47],{"code":47},"D","：持久性，事务完成后数据被写入硬盘持久化",[14,50,51],{},"我们可以看到windows下安装的mysql的Data目录下有很多数据块",[14,53,54],{},[55,56],"img",{"alt":57,"src":58},"image-20250828123204951","https:\u002F\u002Fcdn.jsdelivr.net\u002Fgh\u002Fcodepzj\u002Fimages@main\u002F20250828123308251.png",[14,60,61,62,65],{},"内部有许多",[21,63,64],{"code":64},"ibs","文件，也就是一张张表",{"title":67,"searchDepth":68,"depth":68,"links":69},"",4,[70],{"id":12,"depth":71,"text":12},2,[73],"数据库","2025-08-28","介绍 MySQL 事务的基本概念、ACID 特性以及事务在保证数据一致性方面的作用。",false,"md",null,{"slots":80},{},true,"\u002F2025\u002F08\u002Fmysql-what-is-transaction",{"text":84,"minutes":85,"time":86,"words":87},"1 min read",0.75,45000,150,{"title":5,"description":75},{"loc":82},"posts\u002F2025\u002F08\u002Fmysql-what-is-transaction",[92,93],"MySQL","数据库事务","tech","R_2yrvzpEcKa4OY74zTrQrEV-Lwz8bLwOMgaQXPSRHU",[97,101],{"title":98,"path":99,"stem":100,"date":74,"type":94,"children":-1},"MySQL 事务隔离级别详解","\u002F2025\u002F08\u002Fmysql-iso