[{"data":1,"prerenderedAt":342},["ShallowReactive",2],{"content:\u002F2025\u002F12\u002Fmcp-server-intro":3,"surround:\u002F2025\u002F12\u002Fmcp-server-intro":331},{"id":4,"title":5,"body":6,"categories":308,"date":310,"description":311,"draft":312,"extension":313,"image":314,"meta":315,"navigation":317,"path":318,"permalink":314,"published":314,"readingTime":319,"recommend":314,"references":314,"seo":324,"sitemap":325,"stem":326,"tags":327,"type":329,"updated":310,"__hash__":330},"content\u002Fposts\u002F2025\u002F12\u002Fmcp-server-intro.md","MCP Server 基础概念与入门实践",{"type":7,"value":8,"toc":290},"minimark",[9,13,16,20,23,29,33,36,61,64,72,75,86,90,93,104,108,113,120,123,131,135,141,145,151,155,163,166,170,176,180,189,192,200,203,210,213,217,220,226,229,235,241,245,248,251,257,265,268,271,274,279,285],[10,11,12],"p",{},"随着ai的快速发展，mcp server也逐渐被大家所熟知，但是我只是大概知道有这么个东西，经常在一些文档、组件库当中看到其接入方式，但是具体怎么使用，还是一头雾水",[10,14,15],{},"于是，这周末我花了一点时间研究了一下mcp server",[17,18,19],"h2",{"id":19},"什么是mcp协议",[10,21,22],{},"mcp协议是model context protocol的缩写，是一种用于与ai模型交互的协议。",[24,25,26],"blockquote",{},[10,27,28],{},"mcp协议的目的是：提供一个标准化的接口，实现标准输入【自然语言】与大模型之间的交互",[17,30,32],{"id":31},"mcp-server的原理","mcp server的原理",[10,34,35],{},"mcp server的原理是：",[37,38,39,43,46,49,52,55,58],"ol",{},[40,41,42],"li",{},"人通过mcp client输入文字",[40,44,45],{},"向mcp server获取list of tools",[40,47,48],{},"mcp client将文字和list of tools发送给大模型",[40,50,51],{},"大模型根据文字和list of tools选择一个最合适工具",[40,53,54],{},"提供参数，调用mcp server的tool，获取结果",[40,56,57],{},"mcp server将输出结果返回给大模型",[40,59,60],{},"大模型对信息进行总结，并返回给用户",[10,62,63],{},"对应有两个作用：",[37,65,66,69],{},[40,67,68],{},"接受mcp client调用，返回list of tools",[40,70,71],{},"接受大模型调用，选择最合适的tool，大模型提供参数，mcp server调用tool，返回结果给大模型",[10,73,74],{},"具体流程图如下：",[76,77,83],"pre",{"className":78,"code":80,"language":81,"meta":82},[79],"language-mermaid","sequenceDiagram\n    participant User as 用户\n    participant Client as MCP Client\n    participant Server as MCP Server\n    participant Model as 大模型\n\n    User->>Client: 输入文字（自然语言）\n    Client->>Server: 请求可用工具列表\n    Server-->>Client: 返回工具列表\n    Client->>Model: 发送文字 + 工具列表\n    Model->>Model: 分析输入，选择工具\n    Model->>Server: 调用工具并传入参数\n    Server-->>Model: 返回工具执行结果\n    Model->>Client: 整合结果生成自然语言\n    Client-->>User: 返回最终结果\n","mermaid","",[84,85,80],"code",{"__ignoreMap":82},[17,87,89],{"id":88},"mcp-server的实现","mcp server的实现",[10,91,92],{},"mcp server的实现方式有多种，官方也提供了多种语言的sdk",[24,94,95],{},[10,96,97,98],{},"官方Github仓库地址：",[99,100,101],"a",{"href":101,"rel":102},"https:\u002F\u002Fgithub.com\u002Forgs\u002Fmodelcontextprotocol\u002Frepositories",[103],"nofollow",[17,105,107],{"id":106},"python实现一个简单的mcp-server","python实现一个简单的mcp server",[109,110,112],"h3",{"id":111},"_1-下载uv","1. 下载uv",[10,114,115,116],{},"官方文档：",[99,117,118],{"href":118,"rel":119},"https:\u002F\u002Fdocs.astral.sh\u002Fuv\u002F",[103],[10,121,122],{},"安装命令",[76,124,129],{"className":125,"code":127,"language":128,"meta":82},[126],"language-bash","curl -LsSf https:\u002F\u002Fastral.sh\u002Fuv\u002Finstall.sh | sh\n","bash",[84,130,127],{"__ignoreMap":82},[109,132,134],{"id":133},"_2-创建项目","2. 创建项目",[76,136,139],{"className":137,"code":138,"language":128,"meta":82},[126],"uv new mcp-server-demo\n",[84,140,138],{"__ignoreMap":82},[109,142,144],{"id":143},"_3-安装mcp-server依赖","3. 安装mcp server依赖",[76,146,149],{"className":147,"code":148,"language":128,"meta":82},[126],"uv add \"mcp[cli]\"\n",[84,150,148],{"__ignoreMap":82},[109,152,154],{"id":153},"_4-新建mainpy","4. 新建main.py",[76,156,161],{"className":157,"code":159,"language":160,"meta":82},[158],"language-python","from mcp.server.fastmcp import FastMCP\n\nmcp = FastMCP(\"Demo\")\n\n\n@mcp.tool()\ndef add(a: int, b: int) -> int:\n    # 这个注释是必须要写的\n    \"\"\"Add two numbers\"\"\"\n    return a + b\n\n\n@mcp.resource(\"greeting:\u002F\u002F{name}\")\ndef get_greeting(name: str) -> str:\n    \"\"\"Get a Peosonize Greeting\"\"\"\n    return f\"Hello, {name}\"\n\n\nif __name__ == \"__main__\":\n    print()\n    mcp.run(transport=\"stdio\")\n","python",[84,162,159],{"__ignoreMap":82},[10,164,165],{},"函数下方的多行注释是必须要写的，这是mcp server的规范，用于描述工具的用途和参数。",[109,167,169],{"id":168},"_5-运行mcp-server","5. 运行mcp server",[76,171,174],{"className":172,"code":173,"language":128,"meta":82},[126],"uv run mcp-server-demo\n",[84,175,173],{"__ignoreMap":82},[109,177,179],{"id":178},"_6-在cherry-studio中接入mcp-server","6. 在cherry studio中接入mcp server",[24,181,182],{},[10,183,184,185],{},"cherry studio官方地址：",[99,186,187],{"href":187,"rel":188},"https:\u002F\u002Fwww.cherry-ai.com\u002F",[103],[10,190,191],{},"用这个ai客户端的原因是：",[37,193,194,197],{},[40,195,196],{},"国内服务器，速度快",[40,198,199],{},"免费使用Qwen3-8B和GLM4.5大模型",[10,201,202],{},"在cherry studio中接入mcp server：",[10,204,205],{},[206,207],"img",{"alt":208,"src":209},"image-20251229020855873","https:\u002F\u002Fcdn.jsdelivr.net\u002Fgh\u002Fcodepzj\u002Fimages@main\u002F20251229021031618.png",[10,211,212],{},"保存后启动，如果开关能正常启用，则说明mcp server接入成功",[109,214,216],{"id":215},"_7-使用","7. 使用",[10,218,219],{},"选择“加法”这个tool",[10,221,222],{},[206,223],{"alt":224,"src":225},"image-20251229021157270","https:\u002F\u002Fcdn.jsdelivr.net\u002Fgh\u002Fcodepzj\u002Fimages@main\u002F20251229021159310.png",[10,227,228],{},"然后提问",[10,230,231],{},[206,232],{"alt":233,"src":234},"image-20251229021352842","https:\u002F\u002Fcdn.jsdelivr.net\u002Fgh\u002Fcodepzj\u002Fimages@main\u002F20251229021355176.png",[10,236,237],{},[238,239,240],"strong",{},"非常🐮🍺，真的实现了！",[17,242,244],{"id":243},"ai编程软件接入mcp-server","ai编程软件接入mcp server",[10,246,247],{},"cursor，codex，claude code，trae等其实都是mcp client，他们也可以接入许多mcp server去实现更加复杂的功能，提升开发效率",[10,249,250],{},"举个cursor的例子",[10,252,253,254],{},"新建",[84,255,256],{"code":256},".cursor\u002Fmcp.json",[76,258,263],{"className":259,"code":261,"language":262,"meta":82},[260],"language-json","{\n  \"mcpServers\": {\n    \"mysql\": {\n      \"command\": \"uv\",\n      \"args\": [\n        \"--directory\",\n        \"\u002FUsers\u002Fpzj\u002FCode\u002Fmcp\u002Fmysql_mcp_server\",\n        \"run\",\n        \"mysql_mcp_server\"\n      ],\n      \"env\": {\n        \"MYSQL_HOST\": \"xx.xx.xx.xx\",\n        \"MYSQL_PORT\": \"3306\",\n        \"MYSQL_USER\": \"xx\",\n        \"MYSQL_PASSWORD\": \"xx\",\n        \"MYSQL_DATABASE\": \"xx\"\n      }\n    },\n    \"Ant Design Components\": {\n      \"command\": \"npx\",\n      \"args\": [\n        \"@jzone-mcp\u002Fantd-components-mcp\"\n      ]\n    },\n    \"next-devtools\": {\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"next-devtools-mcp@latest\"]\n    },\n    \"tailwindcss-server\": {\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"tailwindcss-mcp-server\"]\n    },\n    \"note-server - API 文档\": {\n      \"command\": \"npx\",\n      \"args\": [\n        \"-y\",\n        \"apifox-mcp-server@latest\",\n        \"--project-id=xx\"\n      ],\n      \"env\": {\n        \"APIFOX_ACCESS_TOKEN\": \"xx\"\n      }\n    }\n  }\n}\n","json",[84,264,261],{"__ignoreMap":82},[10,266,267],{},"可以看到，我在cursor中接入了mysql，ant design，next，tailwindcss，apifox等mcp server，这样我就可以在cursor中使用这些工具来辅助我编程，大大提升开发效率",[10,269,270],{},"但是，我发现市面上的mcp server大多数都是一些小工具以及组件库的mcp server",[10,272,273],{},"对于一些后端的服务如mysql，redis，mongodb，elasticsearch，kafka，rabbitmq等，市面上的mcp server可能有，但是仅仅只是执行命令而已，而且数据非常敏感并且交给ai操作安全性特别低",[10,275,276],{},[238,277,278],{},"ai竟然真能删库跑路",[10,280,281],{},[206,282],{"alt":283,"src":284},"e1d9557be738210c25fd35d942881dfc","https:\u002F\u002Fcdn.jsdelivr.net\u002Fgh\u002Fcodepzj\u002Fimages@main\u002F20251229022607508.png",[10,286,287],{},[238,288,289],{},"所以我们在使用ai写代码的时候，一定要进行code review，不要把ai写的代码直接提交到仓库，代码是ai写的，锅不能甩给ai，风险是自己的🤡",{"title":82,"searchDepth":291,"depth":291,"links":292},4,[293,295,296,297,307],{"id":19,"depth":294,"text":19},2,{"id":31,"depth":294,"text":32},{"id":88,"depth":294,"text":89},{"id":106,"depth":294,"text":107,"children":298},[299,301,302,303,304,305,306],{"id":111,"depth":300,"text":112},3,{"id":133,"depth":300,"text":134},{"id":143,"depth":300,"text":144},{"id":153,"depth":300,"text":154},{"id":168,"depth":300,"text":169},{"id":178,"depth":300,"text":179},{"id":215,"depth":300,"text":216},{"id":243,"depth":294,"text":244},[309],"工程实践","2025-12-28","mcp server原理理解，实操教程，ai客户端引入以及对ai编程的一些看法",false,"md",null,{"slots":316},{},true,"\u002F2025\u002F12\u002Fmcp-server-intro",{"text":320,"minutes":321,"time":322,"words":323},"6 min read",5.035,302100,1007,{"title":5,"description":311},{"loc":318},"posts\u002F2025\u002F12\u002Fmcp-server-intro",[328],"mcp","tech","yUYV3lPXw6JLK5S0q_g9DBgoBOCGUDsqb9ku0ltCH-s",[332,337],{"title":333,"path":334,"stem":335,"date":336,"type":329,"children":-1},"gRPC 四种通信模式详解","\u002F2025\u002F12\u002Fgrpc-4method","posts\u002F2025\u002F12\u002Fgrpc-4method","2025-12-16",{"title":338,"path":339,"stem":340,"date":341,"type":329,"children":-1},"使用 Go 构建第一个 gRPC 服务","\u002F2026\u002F01\u002Fgrpc-hello-demo","posts\u002F2026\u002F01\u002Fgrpc-hello-demo","2026-01-01",1786037979534]