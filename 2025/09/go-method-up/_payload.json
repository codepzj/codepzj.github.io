[{"data":1,"prerenderedAt":89},["ShallowReactive",2],{"content:\u002F2025\u002F09\u002Fgo-method-up":3,"surround:\u002F2025\u002F09\u002Fgo-method-up":78},{"id":4,"title":5,"body":6,"categories":55,"date":57,"description":58,"draft":59,"extension":60,"image":61,"meta":62,"navigation":64,"path":65,"permalink":61,"published":61,"readingTime":66,"recommend":61,"references":61,"seo":71,"sitemap":72,"stem":73,"tags":74,"type":75,"updated":76,"__hash__":77},"content\u002Fposts\u002F2025\u002F09\u002Fgo-method-up.md","Go 方法提升与嵌入类型",{"type":7,"value":8,"toc":52},"minimark",[9,13,16,19,22,33,36,43],[10,11,12],"p",{},"在go的源码中经常看到这种形式",[10,14,15],{},"结构体经常嵌套一个匿名的接口，这样写的要求是当前结构体实现了该接口的所有方法",[10,17,18],{},"struct嵌套interface",[10,20,21],{},"代码如下",[23,24,30],"pre",{"className":25,"code":27,"language":28,"meta":29},[26],"language-go","package main\n\nimport \"fmt\"\n\ntype Person struct {\n\tName string\n\tDog\n}\n\ntype Dog interface {\n\tEat()\n\tBark()\n}\n\ntype Husky struct {\n}\n\nfunc (h Husky) Eat() {\n\tfmt.Println(\"eat\")\n}\n\nfunc (h Husky) Bark() {\n\tfmt.Println(\"bark\")\n}\n\nfunc main() {\n\tp := Person{\n\t\tName: \"codepzj\",\n\t\tDog:  Husky{},\n\t}\n\n\tp.Eat()\n\tp.Bark()\n\n}\n","go","",[31,32,27],"code",{"__ignoreMap":29},[10,34,35],{},"我们在初始化的时候直接赋值，然后通过Person就能调用Dog接口的Eat和Bark方法",[10,37,38,39],{},"这叫作",[40,41,42],"strong",{},"方法提升",[10,44,45,46],{},"详细资料可看：",[47,48,49],"a",{"href":49,"rel":50},"https:\u002F\u002Fjuejin.cn\u002Fpost\u002F7120219197799563278",[51],"nofollow",{"title":29,"searchDepth":53,"depth":53,"links":54},4,[],[56],"Go语言","2025-09-24","今天聊一下go的方法提升，在很多源码看到，查资料才发现可以这样用",false,"md",null,{"slots":63},{},true,"\u002F2025\u002F09\u002Fgo-method-up",{"text":67,"minutes":68,"time":69,"words":70},"1 min read",0.78,46800,156,{"title":5,"description":58},{"loc":65},"posts\u002F2025\u002F09\u002Fgo-method-up",[28],"tech","2025-09-27","GX4B_I9uMSZ5lS8I9cWrI3AVo2WNb0urh4qCzoNvNcw",[79,84],{"title":80,"path":81,"stem":82,"date":83,"type":75,"children":-1},"docker部署mysql中文乱码问题","\u002F2025\u002F09\u002Fdocker-mysql-charset-problem","posts\u002F2025\u002F09\u002Fdocker-mysql-charset-problem","2025-09-17",{"title":85,"path":86,"stem":87,"date":88,"type":75,"children":-1},"Redis 缓存穿透、击穿与雪崩","\u002F2025\u002F09\u002Fredis-ctjcxb","posts\u002F2025\u002F09\u002Fredis-ctjcxb","2025-09-25",1786037980251]