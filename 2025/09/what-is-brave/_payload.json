[{"data":1,"prerenderedAt":81},["ShallowReactive",2],{"content:\u002F2025\u002F09\u002Fwhat-is-brave":3,"surround:\u002F2025\u002F09\u002Fwhat-is-brave":71},{"id":4,"title":5,"body":6,"categories":47,"date":49,"description":50,"draft":51,"extension":52,"image":53,"meta":54,"navigation":56,"path":57,"permalink":53,"published":53,"readingTime":58,"recommend":53,"references":53,"seo":63,"sitemap":64,"stem":65,"tags":66,"type":68,"updated":69,"__hash__":70},"content\u002Fposts\u002F2025\u002F09\u002Fwhat-is-brave.md","什么是勇敢",{"type":7,"value":8,"toc":43},"minimark",[9,13,16,19,22,25,28,31,34,37,40],[10,11,12],"p",{},"勇敢就是，在你没开始的时候就知道自己注定会输，但依然义无反顾去做。",[10,14,15],{},"毫无畏惧、敢打敢杀、不管不顾，这只是一种表面上的“勇敢”。",[10,17,18],{},"真正的勇敢，并非不恐惧，而是带着恐惧，依然前行。",[10,20,21],{},"《老人与海》里的老渔夫，连续84天没有捕到鱼了，海上的风浪越来越大。",[10,23,24],{},"他知道接下来的日子，可能也会空手而归，但仍然选择在第85天继续出海。",[10,26,27],{},"这是勇敢。",[10,29,30],{},"看清了生活的残酷真相，但依然热爱它，这也是勇敢。",[10,32,33],{},"勇敢是一种品性，更是一种选择。",[10,35,36],{},"没有天生勇敢的人，只有在一次次“明知不可为而为之”的历练中，不断成长的人。",[10,38,39],{},"与生活交手，无论如何都需要一点勇气。",[10,41,42],{},"前进时需要，后退时也需要，进退两难时更需要。",{"title":44,"searchDepth":45,"depth":45,"links":46},"",4,[],[48],"成长随笔","2025-09-25","从个人成长和现实选择出发，讨论勇敢的含义，以及面对困难、未知与责任时应有的态度。",false,"md",null,{"slots":55},{},true,"\u002F2025\u002F09\u002Fwhat-is-brave",{"text":59,"minutes":60,"time":61,"words":62},"2 min read",1.2,72000,240,{"title":5,"description":50},{"loc":57},"posts\u002F2025\u002F09\u002Fwhat-is-brave",[67],"觉悟","tech","2025-09-27","SEI11_X5L8G2uqewNpHdv_TlZNqtUvwpYfcTXLGKmyM",[72,76],{"title":73,"path":74,"stem":75,"date":49,"type":68,"children":-1},"Redis 缓存穿透、击穿与雪崩","\u002F2025\u002F09\u002Fredis-ctjcxb","posts\u002F2025\u002F09\u002Fredis-ctjcxb",{"title":77,"path":78,"stem":79,"date":80,"type":68,"children":-1},"Go 接入腾讯云短信服务","\u002F2025\u002F09\u002Ftecent-sms-send","posts\u002F2025\u002F09\u002Ftecent-sms-send","2025-09-28",1786037980242]