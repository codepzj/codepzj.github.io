[{"data":1,"prerenderedAt":123},["ShallowReactive",2],{"content:\u002F2025\u002F09\u002Fdocker-mysql-charset-problem":3,"surround:\u002F2025\u002F09\u002Fdocker-mysql-charset-problem":112},{"id":4,"title":5,"body":6,"categories":90,"date":92,"description":93,"draft":94,"extension":95,"image":96,"meta":97,"navigation":99,"path":100,"permalink":96,"published":96,"readingTime":101,"recommend":96,"references":96,"seo":106,"sitemap":107,"stem":108,"tags":109,"type":110,"updated":92,"__hash__":111},"content\u002Fposts\u002F2025\u002F09\u002Fdocker-mysql-charset-problem.md","docker部署mysql中文乱码问题",{"type":7,"value":8,"toc":87},"minimark",[9,17,24,31,41,44,52,58,67,72,75,78],[10,11,12],"p",{},[13,14],"img",{"alt":15,"src":16},"image","https:\u002F\u002Fcdn.jsdelivr.net\u002Fgh\u002Fcodepzj\u002Fimages@main\u002F20250917234014825.png",[10,18,19,20],{},"今天docker部署mysql，不知道什么原因中文乱码了，估计是字符集没有设置为",[21,22,23],"code",{"code":23},"utf8",[10,25,26,27,30],{},"原本的",[21,28,29],{"code":29},"docker-compose.yaml","配置为",[32,33,39],"pre",{"className":34,"code":36,"language":37,"meta":38},[35],"language-yaml","version: \"3.9\"\n\nservices:\n  mysql:\n    image: mysql:8.0\n    container_name: askos-mysql\n    restart: always\n    environment:\n      MYSQL_ROOT_PASSWORD: 123456\n      MYSQL_DATABASE: askos\n      TZ: Asia\u002FShanghai\n    ports:\n      - \"13306:3306\"\n    volumes:\n      - .\u002Fdata\u002Fmysql-data:\u002Fvar\u002Flib\u002Fmysql\n      - .\u002Fscripts\u002Fmysql-init.sql:\u002Fdocker-entrypoint-initdb.d\u002Fmysql-init.sql:ro\n","yaml","",[21,40,36],{"__ignoreMap":38},[10,42,43],{},"后面在网上找到相关记录，sql脚本需要指定一下字符集",[32,45,50],{"className":46,"code":48,"language":49,"meta":38},[47],"language-sql","\u002F*!40101 SET NAMES utf8 *\u002F;\n","sql",[21,51,48],{"__ignoreMap":38},[10,53,54,55],{},"然后执行",[21,56,57],{"code":57},"docker-compose down && rm -rf data && docker-compose up -d",[10,59,60,61,64,65],{},"navicat连接发现表的中文注释也乱码，后面搜了一下教程，发现",[21,62,63],{"code":63},"navicat","高级里面也可以设置字符集",[21,66,23],{"code":23},[10,68,69],{},[13,70],{"alt":15,"src":71},"https:\u002F\u002Fcdn.jsdelivr.net\u002Fgh\u002Fcodepzj\u002Fimages@main\u002F20250918014100847.png",[10,73,74],{},"设置完后表中的注释和中文字符都正常显示",[10,76,77],{},"参考文章：",[10,79,80],{},[81,82,86],"a",{"href":83,"rel":84},"https:\u002F\u002Fzhuanlan.zhihu.com\u002Fp\u002F74428428",[85],"nofollow","Navicat连接mysql数据库记录中文乱码的解决方法",{"title":38,"searchDepth":88,"depth":88,"links":89},4,[],[91],"数据库","2025-09-17","分析 Docker 部署 MySQL 后出现中文乱码的原因，并通过服务端与连接字符集配置解决问题。",false,"md",null,{"slots":98},{},true,"\u002F2025\u002F09\u002Fdocker-mysql-charset-problem",{"text":102,"minutes":103,"time":104,"words":105},"1 min read",0.845,50700,169,{"title":5,"description":93},{"loc":100},"posts\u002F2025\u002F09\u002Fdocker-mysql-charset-problem",[49],"tech","FBuAwpU51DBhAj9XtX0tqeTP2zv61bJVyhOp9xyPrtI",[113,118],{"title":114,"path":115,"stem":116,"date":117,"type":110,"children":-1},"Protocol Buffers 安装与 Go 插件配置","\u002F2025\u002F09\u002Fproto-install","posts\u002F2025\u002F09\u002Fproto-install","2025-09-15",{"title":119,"path":120,"stem":121,"date":122,"type":110,"children":-1},"Go 方法提升与嵌入类型","\u002F2025\u002F09\u002Fgo-method-up","posts\u002F2025\u002F09\u002Fgo-method-up","2025-09-24",1786037980279]