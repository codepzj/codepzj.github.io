[{"data":1,"prerenderedAt":81},["ShallowReactive",2],{"content:\u002F2025\u002F09\u002Fthe-courage-to-grow-slowly":3,"surround:\u002F2025\u002F09\u002Fthe-courage-to-grow-slowly":72},{"id":4,"title":5,"body":6,"categories":48,"date":50,"description":51,"draft":52,"extension":53,"image":54,"meta":55,"navigation":57,"path":58,"permalink":54,"published":54,"readingTime":59,"recommend":54,"references":54,"seo":64,"sitemap":65,"stem":66,"tags":67,"type":69,"updated":70,"__hash__":71},"content\u002Fposts\u002F2025\u002F09\u002Fthe-courage-to-grow-slowly.md","不急于求成，才是最长远的成长",{"type":7,"value":8,"toc":44},"minimark",[9,13,16,19,22,41],[10,11,12],"p",{},"当今社会，人们愈发急躁，过度追求功利，急于求成。但往往由于实力不足，无法真正驾驭所学的技术，最后只能选择“躺平”。",[10,14,15],{},"这种现象的根源，一方面在于社会资源的有限与分配不均，另一方面则是过度的内卷导致就业生态畸形。许多人急功近利，总以为努力必然会有回报，涉猎的知识广而浅，却忽略了真正的积累与沉淀。于是，他们将技术与高薪划上等号，屡屡受挫后心态逐渐崩塌。",[10,17,18],{},"“金九银十”的求职季，更容易让人焦虑。但越是紧张的时候，越要冷静下来。",[10,20,21],{},"在我看来应该做到以下几点：",[23,24,25,29,32,35,38],"ol",{},[26,27,28],"li",{},"提高专注力，远离手机，设置健康使用时间",[26,30,31],{},"培养独立思考的能力，遇到事情，想多种解决方案",[26,33,34],{},"多阅读文章，吸取前人的经验和教训",[26,36,37],{},"多写文章，记录每天学习的知识点",[26,39,40],{},"每天制定计划表，按规律进行",[10,42,43],{},"有时候，在这急躁的社会中缓慢向上也是一种勇气。",{"title":45,"searchDepth":46,"depth":46,"links":47},"",4,[],[49],"成长随笔","2025-09-01","在浮躁与内卷的社会中，保持专注与冷静，缓慢向上，也是最难得的成长勇气。",false,"md",null,{"slots":56},{},true,"\u002F2025\u002F09\u002Fthe-courage-to-grow-slowly",{"text":60,"minutes":61,"time":62,"words":63},"2 min read",1.49,89400,298,{"title":5,"description":51},{"loc":58},"posts\u002F2025\u002F09\u002Fthe-courage-to-grow-slowly",[68],"life","tech","2025-09-05","P_yrW-lwbUc_EXP_TbPLEniKStdPrqNHwzlOjDTGEy0",[73,77],{"title":74,"path":75,"stem":76,"date":50,"type":69,"children":-1},"MySQL 查询性能分析方法","\u002F2025\u002F09\u002Fmysql-performance-analyse","posts\u002F2025\u002F09\u002Fmysql-performance-analyse",{"title":78,"path":79,"stem":80,"date":70,"type":69,"children":-1},"10万行报表导出优化实战：从 OFFSET 到游标分页","\u002F2025\u002F09\u002Freport-export-optimization-from-offset-to-cursor-pagination","posts\u002F2025\u002F09\u002Freport-export-optimization-from-offset-to-cursor-pagination",1786037980759]