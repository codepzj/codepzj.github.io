[{"data":1,"prerenderedAt":78},["ShallowReactive",2],{"content:\u002F2025\u002F09\u002Fredis-set-command":3,"surround:\u002F2025\u002F09\u002Fredis-set-command":69},{"id":4,"title":5,"body":6,"categories":44,"date":46,"description":47,"draft":48,"extension":49,"image":50,"meta":51,"navigation":53,"path":54,"permalink":50,"published":50,"readingTime":55,"recommend":50,"references":50,"seo":60,"sitemap":61,"stem":62,"tags":63,"type":66,"updated":67,"__hash__":68},"content\u002Fposts\u002F2025\u002F09\u002Fredis-set-command.md","Redis Set 常用命令",{"type":7,"value":8,"toc":39},"minimark",[9,14,18,25,28],[10,11,13],"h2",{"id":12},"set-常用命令","set 常用命令",[15,16,17],"p",{},"set代表集合，该数据结构不能出现重复的元素",[15,19,20],{},[21,22],"img",{"alt":23,"src":24},"image-20250911144704105","https:\u002F\u002Fcdn.jsdelivr.net\u002Fgh\u002Fcodepzj\u002Fimages@main\u002F20250911144706079.png",[15,26,27],{},"常用命令",[29,30,36],"pre",{"className":31,"code":33,"language":34,"meta":35},[32],"language-bash","SADD myset 1 2 3  \u002F\u002F 往集合插入3个值\n\nSMEMBERS myset \u002F\u002F 查看集合的所有元素\n\nSISMEMBER myset 1 \u002F\u002F 查看1是否为该集合中的元素\n\nSCARD myset \u002F\u002F 返回集合当中元素的个数\n\nSREM myset 1 \u002F\u002F 删除集合中的特定元素\n\nSADD  s1 1 2 3\nSADD s2 1 2 4\n\nSINTER s1 s2 \u002F\u002F 1, 2\nSDIFF s1 s2 \u002F\u002F 3\nSUNION s1 s2 \u002F\u002F 1, 2, 3, 4\n","bash","",[37,38,33],"code",{"__ignoreMap":35},{"title":35,"searchDepth":40,"depth":40,"links":41},4,[42],{"id":12,"depth":43,"text":13},2,[45],"数据库","2025-09-10","整理 Redis Set 集合的元素增删、成员查询、集合遍历以及交并差集等常用命令。",false,"md",null,{"slots":52},{},true,"\u002F2025\u002F09\u002Fredis-set-command",{"text":56,"minutes":57,"time":58,"words":59},"1 min read",0.64,38400,128,{"title":5,"description":47},{"loc":54},"posts\u002F2025\u002F09\u002Fredis-set-command",[64,65],"Redis","数据结构","tech","2025-09-11","Os5doMVOua3g4QlVt0Jw-v7oki5L2Qc5Vya1hn2NoMg",[70,74],{"title":71,"path":72,"stem":73,"date":46,"type":66,"children":-1},"NoSQL 数据库基础概念","\u002F2025\u002F09\u002Fredis-nosql","p