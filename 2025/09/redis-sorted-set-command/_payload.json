[{"data":1,"prerenderedAt":91},["ShallowReactive",2],{"content:\u002F2025\u002F09\u002Fredis-sorted-set-command":3,"surround:\u002F2025\u002F09\u002Fredis-sorted-set-command":82},{"id":4,"title":5,"body":6,"categories":57,"date":59,"description":60,"draft":61,"extension":62,"image":63,"meta":64,"navigation":66,"path":67,"permalink":63,"published":63,"readingTime":68,"recommend":63,"references":63,"seo":73,"sitemap":74,"stem":75,"tags":76,"type":79,"updated":80,"__hash__":81},"content\u002Fposts\u002F2025\u002F09\u002Fredis-sorted-set-command.md","Redis Sorted Set 常用命令",{"type":7,"value":8,"toc":52},"minimark",[9,13,26,33,36,42],[10,11,12],"h2",{"id":12},"sorted-set常用命令",[14,15,16,17,21,22,25],"p",{},"相对于",[18,19,20],"code",{"code":20},"set","，sorted_set还维护一个",[18,23,24],{"code":24},"score","字段，在字段不重复的基础上，按照分数从低到高进行排序",[14,27,28],{},[29,30],"img",{"alt":31,"src":32},"image-20250911145700057","https:\u002F\u002Fcdn.jsdelivr.net\u002Fgh\u002Fcodepzj\u002Fimages@main\u002F20250911145701535.png",[14,34,35],{},"常用命令",[14,37,38],{},[29,39],{"alt":40,"src":41},"image-20250911145812497","https:\u002F\u002Fcdn.jsdelivr.net\u002Fgh\u002Fcodepzj\u002Fimages@main\u002F20250911145814185.png",[43,44,50],"pre",{"className":45,"code":47,"language":48,"meta":49},[46],"language-bash","ZADD msset 100 chinese 150 math 145 english \u002F\u002F 前面是分数后面是键\n\nZRANGE msset 0 2 [WITHSCORES] \u002F\u002F 查看有序集合中前三个元素，如果填写WITHSCORES则会带上分数\n\nZSCORE msset chinese \u002F\u002F 查看语文的分数\n\nZRANK msset math \u002F\u002F 查看数学的排名 \n\nZREVRANK msset math \u002F\u002F 查看数学排名【从大到小】\n\nZREM msset chinese \u002F\u002F 删除语文这门学科\n","bash","",[18,51,47],{"__ignoreMap":49},{"title":49,"searchDepth":53,"depth":53,"links":54},4,[55],{"id":12,"depth":56,"text":12},2,[58],"数据库","2025-09-10","整理 Redis Sorted Set 的成员写入、分数排序、区间查询和排名统计等常用命令。",false,"md",null,{"slots":65},{},true,"\u002F2025\u002F09\u002Fredis-sorted-set-command",{"text":69,"minutes":70,"time":71,"words":72},"1 min read",0.685,41100,137,{"title":5,"des