[{"data":1,"prerenderedAt":88},["ShallowReactive",2],{"content:\u002F2025\u002F09\u002Fmysql-index-description":3,"surround:\u002F2025\u002F09\u002Fmysql-index-description":79},{"id":4,"title":5,"body":6,"categories":55,"date":57,"description":58,"draft":59,"extension":60,"image":61,"meta":62,"navigation":64,"path":65,"permalink":61,"published":61,"readingTime":66,"recommend":61,"references":61,"seo":71,"sitemap":72,"stem":73,"tags":74,"type":77,"updated":57,"__hash__":78},"content\u002Fposts\u002F2025\u002F09\u002Fmysql-index-description.md","MySQL 索引基础与工作原理",{"type":7,"value":8,"toc":50},"minimark",[9,13,17,28,31,34,41,44,47],[10,11,12],"h2",{"id":12},"什么是索引",[14,15,16],"p",{},"索引是一种mysql用来优化查询效率的一种数据结构【一般为二叉树】，存储在磁盘当中",[18,19,25],"pre",{"className":20,"code":22,"language":23,"meta":24},[21],"language-sql","select * from student where age=18;\n","sql","",[26,27,22],"code",{"__ignoreMap":24},[14,29,30],{},"这一行需要在数据库的第一行开始匹配进行全表扫描，所以效率比较低",[14,32,33],{},"然后加索引后就会在数据库中维护一个多叉树的数据结构，如:",[14,35,36],{},[37,38],"img",{"alt":39,"src":40},"image-20250829114955134","https:\u002F\u002Fcdn.jsdelivr.net\u002Fgh\u002Fcodepzj\u002Fimages@main\u002F20250829115015738.png",[14,42,43],{},"只需要少次判断即可查询到对应的数据",[14,45,46],{},"优点：建立索引，可以通过多叉树去快速找到数据，避免全表扫描，大大提高查询效率",[14,48,49],{},"缺点：在增删改等操作需要额外的去维护这个多叉树，造成性能开销",{"title":24,"searchDepth":51,"depth":51,"links":52},4,[53],{"id":12,"depth":54,"text":12},2,[56],"数据库","2025-09-01","介绍 MySQL 索引的作用、存储方式和查询优化原理，并说明索引对读写性能的影响。",false,"md",null,{"slots":63},{},true,"\u002F2025\u002F09\u002Fmysql-index-description",{"text":67,"minutes":68,"time":69,"words":70},"1 min read",0.9,54000,180,{"title":5,"description":58},{"loc":65},"posts\u002F2025\u002F09\u002Fmysql-index-description",[75,76],"MySQL","数据库索引","tech","giq7busJiflHa7LzniC7gHl1kFWlge0akPM0-ddjNY4",[80,84],{"title":81,"path":82,"stem":83,"date":57,"type":77,"children":-1},"MySQL 索引类型与分类","\u002F2025\u002F09\u002Fmysql-index-category","posts\u002F2025\u002F09\u002Fmysql-index-category",{"title":85,"path":86,"stem":87,"date":57,"type":77,"children":-1},"MySQL 查询性能分析方法","\u002F2025\u002F09\u002Fmysql-performance-analyse","posts\u002F2025\u002F09\u002Fmysql-performance-analyse",1786037980743]