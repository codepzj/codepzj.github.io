[{"data":1,"prerenderedAt":173},["ShallowReactive",2],{"content:\u002F2025\u002F09\u002Fgo-defer":3,"surround:\u002F2025\u002F09\u002Fgo-defer":162},{"id":4,"title":5,"body":6,"categories":140,"date":142,"description":143,"draft":144,"extension":145,"image":146,"meta":147,"navigation":149,"path":150,"permalink":146,"published":146,"readingTime":151,"recommend":146,"references":146,"seo":156,"sitemap":157,"stem":158,"tags":159,"type":160,"updated":142,"__hash__":161},"content\u002Fposts\u002F2025\u002F09\u002Fgo-defer.md","Go Defer 执行机制详解",{"type":7,"value":8,"toc":135},"minimark",[9,27,32,42,67,70,80,83,91,95,98,101,112,115,129,132],[10,11,12,13,17,18,22,23,26],"p",{},"我们都知道，",[14,15,16],"code",{"code":16},"defer","往往在函数的最后执行，遵循",[19,20,21],"strong",{},"先进后出","原则，在",[14,24,25],{"code":25},"return","函数写入返回值后执行，而且传入的形参会立即读入，后续修改对其无影响",[10,28,29],{},[19,30,31],{},"Go 函数返回过程完整流程",[10,33,34,35,37,38,41],{},"当一个函数执行到 ",[14,36,25],{"code":25}," 语句时，",[19,39,40],{},"执行顺序是","：",[43,44,45,55,61],"ol",{},[46,47,48,54],"li",{},[19,49,50,51,53],{},"计算 ",[14,52,25],{"code":25}," 后的表达式","（如果有的话），将结果赋值给返回值；",[46,56,57,60],{},[19,58,59],{},"执行所有的 defer 语句","（按照后进先出 LIFO 的顺序）；",[46,62,63,66],{},[19,64,65],{},"函数真正返回（携带返回值）","。",[10,68,69],{},"下面来看这三个案例",[71,72,78],"pre",{"className":73,"code":75,"language":76,"meta":77},[74],"language-go","package main\n\nimport \"fmt\"\n\nfunc Func1() int {\n\ta := 0\n\tdefer func() {\n\t\ta++\n\t}()\n\treturn a\n}\n\nfunc Func2() (a int) {\n\ta = 0\n\tdefer func() {\n\t\ta++\n\t}()\n\treturn\n}\n\nfunc Func3() *int {\n\ta := new(int)\n\t*a = 0\n\tdefer func() {\n\t\t*a++\n\t}()\n\treturn a\n}\n\nfunc main() {\n\tfmt.Println(Func1())\n\tfmt.Println(Func2())\n\tfmt.Println(*Func3())\n}\n","go","",[14,79,75],{"__ignoreMap":77},[10,81,82],{},"输出结果为",[71,84,89],{"className":85,"code":87,"language":88,"meta":77},[86],"language-bash","0 1 1\n","bash",[14,90,87],{"__ignoreMap":77},[92,93,94],"h2",{"id":94},"案例分析",[10,96,97],{},"这三个究竟有什么区别呢？",[10,99,100],{},"案例一：",[43,102,103,106,109],{},[46,104,105],{},"首先，我们获得a的值0，然后会重新赋值一份给临时的返回槽(slot)当中",[46,107,108],{},"然后，调用defer，修改局部变量a为1，但是a已被copy一份到返回槽，所以重新赋值没有用",[46,110,111],{},"返回0",[10,113,114],{},"案例二：",[43,116,117,120,123,126],{},[46,118,119],{},"首先，Go 在函数进入时会自动为 a 分配内存（在栈上，必要时会逃逸到堆）；",[46,121,122],{},"a的初始值0，然后赋值一份给临时的返回槽(slot)当中",[46,124,125],{},"然后defer修改了a的值",[46,127,128],{},"返回1",[10,130,131],{},"案例三:",[10,133,134],{},"与案例一相似，但是传递的是指针，是引用类型，能修改地址中存储的值，所以返回的是1",{"title":77,"searchDepth":136,"depth":136,"links":137},4,[138],{"id":94,"depth":139,"text":94},2,[141],"Go语言","2025-09-30","本文讲述 Go 函数返回值与 defer 执行顺序的关系，通过三个实例分析值类型、具名返回值及引用类型在返回过程中的不同表现。",false,"md",null,{"slots":148},{},true,"\u002F2025\u002F09\u002Fgo-defer",{"text":152,"minutes":153,"time":154,"words":155},"2 min read",1.99,119400,398,{"title":5,"description":143},{"loc":150},"posts\u002F2025\u002F09\u002Fgo-defer",[76,16],"tech","Su9WV9MePd5wgBstkgKvCdNmEZQrDr7ZNK5wp1RvU9M",[163,168],{"title":164,"path":165,"stem":166,"date":167,"type":160,"children":-1},"Go 接入腾讯云短信服务","\u002F2025\u002F09\u002Ftecent-sms-send","posts\u002F2025\u002F09\u002Ftecent-sms-send","2025-09-28",{"title":169,"path":170,"stem":171,"date":172,"type":160,"children":-1},"kratos中proto文件引入其他proto爆红","\u002F2025\u002F10\u002Fkratos-proto-error","posts\u002F2025\u002F10\u002Fkratos-proto-error","2025-10-25",1786037980021]