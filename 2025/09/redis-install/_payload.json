[{"data":1,"prerenderedAt":130},["ShallowReactive",2],{"content:\u002F2025\u002F09\u002Fredis-install":3,"surround:\u002F2025\u002F09\u002Fredis-install":121},{"id":4,"title":5,"body":6,"categories":97,"date":99,"description":100,"draft":101,"extension":102,"image":103,"meta":104,"navigation":106,"path":107,"permalink":103,"published":103,"readingTime":108,"recommend":103,"references":103,"seo":113,"sitemap":114,"stem":115,"tags":116,"type":119,"updated":99,"__hash__":120},"content\u002Fposts\u002F2025\u002F09\u002Fredis-install.md","Redis 安装、启动与连接",{"type":7,"value":8,"toc":90},"minimark",[9,13,17,25,35,38,41,49,52,55,58,72,75,83],[10,11,12],"h2",{"id":12},"redis安装",[14,15,16],"p",{},"这里我为了方便，使用docker来安装redis",[14,18,19,20,24],{},"新建",[21,22,23],"code",{"code":23},"docker-compose.yml","，写入：",[26,27,33],"pre",{"className":28,"code":30,"language":31,"meta":32},[29],"language-yaml","version: '3'\n\nservices:\n  redis:\n    image: redis:latest\n    container_name: redis\n    ports:\n      - \"6379:6379\"\n    command: [\"redis-server\", \"\u002Fusr\u002Flocal\u002Fetc\u002Fredis\u002Fredis.conf\"]\n    volumes:\n      - .\u002Fdata:\u002Fdata\n      - .\u002Fredis.conf:\u002Fusr\u002Flocal\u002Fetc\u002Fredis\u002Fredis.conf\n    restart: always\n","yaml","",[21,34,30],{"__ignoreMap":32},[14,36,37],{},"执行docker-compose up -d，后台运行docker容器",[10,39,40],{"id":40},"redis客户端连接命令",[26,42,47],{"className":43,"code":45,"language":46,"meta":32},[44],"language-bash","redis-cli -h 127.0.0.1 -p 6379 -a 123456\n","bash",[21,48,45],{"__ignoreMap":32},[14,50,51],{},"-h: ip",[14,53,54],{},"-p: 端口",[14,56,57],{},"-a: 密码",[14,59,60,61,64,65,68,69,71],{},"执行",[21,62,63],{"code":63},"ping","，查看redis服务端是否正常返回",[21,66,67],{"code":67},"pong","，若正常返回",[21,70,67],{"code":67},"，则说明redis-server正常启动成功",[10,73,74],{"id":74},"图形化界面",[14,76,77],{},[78,79,80],"a",{"href":80,"rel":81},"https:\u002F\u002Fredis.tinycraft.cc\u002F",[82],"nofollow",[14,84,85],{},[86,87],"img",{"alt":88,"src":89},"image-202