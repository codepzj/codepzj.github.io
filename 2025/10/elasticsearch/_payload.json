[{"data":1,"prerenderedAt":210},["ShallowReactive",2],{"content:\u002F2025\u002F10\u002Felasticsearch":3,"surround:\u002F2025\u002F10\u002Felasticsearch":200},{"id":4,"title":5,"body":6,"categories":177,"date":179,"description":180,"draft":181,"extension":182,"image":183,"meta":184,"navigation":186,"path":187,"permalink":183,"published":183,"readingTime":188,"recommend":183,"references":183,"seo":193,"sitemap":194,"stem":195,"tags":196,"type":198,"updated":179,"__hash__":199},"content\u002Fposts\u002F2025\u002F10\u002Felasticsearch.md","Elasticsearch 安装与基础操作",{"type":7,"value":8,"toc":157},"minimark",[9,13,17,20,23,34,37,44,47,51,59,62,68,71,77,80,86,89,95,98,104,107,113,116,122,125,131,134,140,143,150],[10,11,12],"h2",{"id":12},"介绍",[14,15,16],"p",{},"Elasticsearch 是一个高度可扩展的开源实时搜索和分析引擎，它允许用户在近实时的时间内执行全文搜索、结构化搜索、聚合、过滤等功能。Elasticsearch 基于 Lucene 构建，提供了强大的全文搜索功能，并且具有广泛的应用领域，包括日志和实时分析、社交媒体、电子商务等。",[14,18,19],{},"Elasticsearch 为所有类型的数据提供近乎实时的搜索和分析。无论是结构化文本还是非结构化文本、数字数据或地理空间数据，Elasticsearch 都能够以支持快速搜索的方式有效地存储和索引它们。除了简单的数据检索和聚合信息之外，还可以用 Elasticsearch 发现数据中的趋势和模式。随着数据和查询量的增长，Elasticsearch 的分布式特性能够横向扩展至数以百计的服务器存储以及处理PB级的数据，同时可以在极短的时间内索引、搜索和分析大量的数据。，",[10,21,22],{"id":22},"安装",[24,25,31],"pre",{"className":26,"code":28,"language":29,"meta":30},[27],"language-yaml","version: \"3.8\"\n\nservices:\n  elasticsearch:\n    container_name: elasticsearch\n    image: docker.elastic.co\u002Felasticsearch\u002Felasticsearch:8.9.1\n    environment:\n      - node.name=elasticsearch\n      - ES_JAVA_OPTS=-Xms512m -Xmx512m\n      - discovery.type=single-node\n      - xpack.security.enabled=false\n    ports:\n      - 9200:9200\n      - 9300:9300\n    networks:\n      - elastic\n  kibana:\n    image: docker.elastic.co\u002Fkibana\u002Fkibana:8.9.1\n    container_name: kibana\n    ports:\n      - 5601:5601\n    networks:\n      - elastic\n    depends_on:\n      - elasticsearch\n\nnetworks:\n  elastic:\n","yaml","",[32,33,28],"code",{"__ignoreMap":30},[14,35,36],{},"kibana提供Elasticsearch的命令行工具",[14,38,39,40,43],{},"执行",[32,41,42],{"code":42},"docker-compose up -d","启动ES镜像",[10,45,46],{"id":46},"使用",[48,49,50],"h3",{"id":50},"查看索引",[24,52,57],{"className":53,"code":55,"language":56,"meta":30},[54],"language-http","GET \u002F_cat\u002Findices?v\n","http",[32,58,55],{"__ignoreMap":30},[48,60,61],{"id":61},"创建索引",[24,63,66],{"className":64,"code":65,"language":56,"meta":30},[54],"PUT \u002Fmy1\n",[32,67,65],{"__ignoreMap":30},[48,69,70],{"id":70},"创建文档",[24,72,75],{"className":73,"code":74,"language":56,"meta":30},[54],"POST \u002Fmy1\u002F_create\u002F1\n{\n  \"name\": \"codepzj\",\n  \"age\": 18\n}\n\nPOST \u002Fmy1\u002F_create\u002F2\n{\n  \"name\": \"codepzj\",\n  \"age\": 20\n}\n",[32,76,74],{"__ignoreMap":30},[48,78,79],{"id":79},"获取文档的数据",[24,81,84],{"className":82,"code":83,"language":56,"meta":30},[54],"GET \u002Fmy1\u002F_source\u002F1\n",[32,85,83],{"__ignoreMap":30},[48,87,88],{"id":88},"查看文档是否存在",[24,90,93],{"className":91,"code":92,"language":56,"meta":30},[54],"HEAD \u002Fmy1\u002F_doc\u002F2\n",[32,94,92],{"__ignoreMap":30},[48,96,97],{"id":97},"更新文档",[24,99,102],{"className":100,"code":101,"language":56,"meta":30},[54],"POST \u002Fmy1\u002F_update\u002F1\n{\n  \"doc\": {\n    \"name\": \"codepzj\",\n    \"age\": 20\n  }\n}\n",[32,103,101],{"__ignoreMap":30},[48,105,106],{"id":106},"批量获取文档",[24,108,111],{"className":109,"code":110,"language":56,"meta":30},[54],"GET \u002Fmy1\u002F_mget\n{\n  \"docs\": [\n    {\n      \"_id\": \"1\"\n    },\n    {\n      \"_id\": \"2\"\n    }\n  ]\n}\n",[32,112,110],{"__ignoreMap":30},[48,114,115],{"id":115},"删除文档",[24,117,120],{"className":118,"code":119,"language":56,"meta":30},[54],"DELETE \u002Fmy1\u002F_doc\u002F2\n",[32,121,119],{"__ignoreMap":30},[48,123,124],{"id":124},"全局检索",[24,126,129],{"className":127,"code":128,"language":56,"meta":30},[54],"GET \u002F_search\n",[32,130,128],{"__ignoreMap":30},[48,132,133],{"id":133},"索引检索",[24,135,138],{"className":136,"code":137,"language":56,"meta":30},[54],"GET \u002Fmy1\u002F_search\n",[32,139,137],{"__ignoreMap":30},[10,141,142],{"id":142},"kibana的使用",[14,144,145,146,149],{},"点击",[32,147,148],{"code":148},"Devtools","，直接输入ES命令即可",[14,151,152],{},[153,154],"img",{"alt":155,"src":156},"image-20251027213638469","https:\u002F\u002Fcdn.jsdelivr.net\u002Fgh\u002Fcodepzj\u002Fimages@main\u002F20251027213655202.png",{"title":30,"searchDepth":158,"depth":158,"links":159},4,[160,162,163,176],{"id":12,"depth":161,"text":12},2,{"id":22,"depth":161,"text":22},{"id":46,"depth":161,"text":46,"children":164},[165,167,168,169,170,171,172,173,174,175],{"id":50,"depth":166,"text":50},3,{"id":61,"depth":166,"text":61},{"id":70,"depth":166,"text":70},{"id":79,"depth":166,"text":79},{"id":88,"depth":166,"text":88},{"id":97,"depth":166,"text":97},{"id":106,"depth":166,"text":106},{"id":115,"depth":166,"text":115},{"id":124,"depth":166,"text":124},{"id":133,"depth":166,"text":133},{"id":142,"depth":161,"text":142},[178],"数据库","2025-10-27","elasticsearch是一个分布式搜索引擎，本文讲述了elasticsearch的安装与使用",false,"md",null,{"slots":185},{},true,"\u002F2025\u002F10\u002Felasticsearch",{"text":189,"minutes":190,"time":191,"words":192},"3 min read",2.265,135900,453,{"title":5,"description":180},{"loc":187},"posts\u002F2025\u002F10\u002Felasticsearch",[197],"es","tech","dCZyn0IW2eZ6wuW2N4i0LoeI5Vafc-9xMhXJfvb1P98",[201,205],{"title":202,"path":203,"stem":204,"date":179,"type":198,"children":-1},"go-elasticsearch使用指南","\u002F2025\u002F10\u002Felasticsearch-go","posts\u002F2025\u002F10\u002Felasticsearch-go",{"title":206,"path":207,"stem":208,"date":209,"type":198,"children":-1},"Canal 安装配置与 Go 客户端实践","\u002F2025\u002F10\u002Fcanal","posts\u002F2025\u002F10\u002Fcanal","2025-10-28",1786037979941]