"id":819},"_52-引入其他项目文件","5.2 引入其他项目文件",[24,822,825],{"className":823,"code":824,"language":328,"meta":30},[326],"include:\n  - project: 'group\u002Fci-templates'\n    ref: main\n    file: '\u002Ftemplates\u002Fdocker-build.yml'\n",[32,826,824],{"__ignoreMap":30},[15,828,830],{"id":829},"_53-引入远程-url","5.3 引入远程 URL",[24,832,835],{"className":833,"code":834,"language":328,"meta":30},[326],"include:\n  - remote: 'https:\u002F\u002Fgitlab.com\u002Fgitlab-org\u002Fgitlab-foss\u002Fraw\u002Fmaster\u002F.gitlab-ci.yml'\n",[32,836,834],{"__ignoreMap":30},[15,838,840],{"id":839},"_54-使用官方模板","5.4 使用官方模板",[24,842,845],{"className":843,"code":844,"language":328,"meta":30},[326],"include:\n  - template: 'Go.gitlab-ci.yml'\n",[32,846,844],{"__ignoreMap":30},[15,848,850],{"id":849},"_55-混合引入","5.5 混合引入",[24,852,855],{"className":853,"code":854,"language":328,"meta":30},[326],"include:\n  - local: 'ci\u002Fbuild.yml'\n  - project: 'team\u002Fshared-ci'\n    ref: main\n    file: '\u002Fdeploy\u002Fdocker.yml'\n  - template: 'Go.gitlab-ci.yml'\n",[32,856,854],{"__ignoreMap":30},[15,858,860],{"id":859},"_56-条件引入","5.6 条件引入",[24,862,865],{"className":863,"code":864,"language":328,"meta":30},[326],"include:\n  - local: 'ci\u002Fprod.yml'\n    rules:\n      - if: '$CI_COMMIT_TAG =~ \u002F^pro-\u002F'\n",[32,866,864],{"__ignoreMap":30},[15,868,870],{"id":869},"_57-注意事项","5.7 注意事项",[551,872,873,876,879],{},[54,874,875],{},"所有 include 文件必须合法",[54,877,878],{},"stages 会合并，同名 job 会覆盖",[54,880,881],{},"文件路径错误会导致 CI 解析失败",[10,883,885],{"id":884},"六gitlab-runner使用镜像缓存","六、Gitlab Runner使用镜像缓存",[20,887,888],{},"主要是为了执行job的时候防止重复拉取镜像",[20,890,891,892],{},"配置",[32,893,894],{"code":894},"config\u002Fconfig.toml",[24,896,901],{"className":897,"code":899,"language":900,"meta":30},[898],"language-toml","concurrent = 1\ncheck_interval = 0\nshutdown_timeout = 0\n[session_server]\n  session_timeout = 1800\n[[runners]]\n  name = \"test-ci\"\n  url = \"http:\u002F\u002Fgit.disoms.net\"\n  id = 2\n  token = \"your-gitlab-token\"\n  token_obtained_at = 2025-11-06T10:38:31Z\n  token_expires_at = 0001-01-01T00:00:00Z\n  executor = \"docker\"\n  [runners.cache]\n    MaxUploadedArchiveSize = 0\n    [runners.cache.s3]\n    [runners.cache.gcs]\n    [runners.cache.azure]\n  [runners.docker]\n    tls_verify = false\n    image = \"golang:1.23.4\" # 默认镜像\n    privileged = false\n    disable_entrypoint_overwrite = false\n    oom_kill_disable = false\n    disable_cache = false\n    volumes = [\"\u002Fcache\"] # 缓存\n    pull_policy = [\"if-not-present\"] # 策略\n    shm_size = 0\n    network_mtu = 0\n","toml",[32,902,899],{"__ignoreMap":30},[20,904,905],{},"重启镜像",[10,907,909],{"id":908},"七常见问题与坑点","七、常见问题与坑点",[551,911,912,918,924,930],{},[54,913,914,917],{},[57,915,916],{},"分支读取不到变量","：关闭变量保护（取消 Protect variable）",[54,919,920,923],{},[57,921,922],{},"Runner 不执行 Job","：检查标签匹配及 “Run untagged jobs” 设置",[54,925,926,929],{},[57,927,928],{},"执行器错误","：custom 改为 docker 并重启容器",[54,931,932,935],{},[57,933,934],{},"权限错误","：确认 Token 与注册项目匹配",{"title":30,"searchDepth":937,"depth":937,"links":938},4,[939,947,951,958,964,973,974],{"id":12,"depth":940,"text":13,"children":941},2,[942,944,945,946],{"id":17,"depth":943,"text":18},3,{"id":36,"depth":943,"text":37},{"id":87,"depth":943,"text":88},{"id":197,"depth":943,"text":198},{"id":245,"depth":940,"text":246,"children":948},[949,950],{"id":249,"depth":943,"text":250},{"id":283,"depth":943,"text":284},{"id":313,"depth":940,"text":314,"children":952},[953,955,956,957],{"id":317,"depth":943,"text":954},"3.1 .gitlab-ci.yml 文件结构",{"id":333,"depth":943,"text":334},{"id":446,"depth":943,"text":447},{"id":548,"depth":943,"text":549},{"id":577,"depth":940,"text":578,"children":959},[960,961,962,963],{"id":581,"depth":943,"text":582},{"id":593,"depth":943,"text":594},{"id":657,"depth":943,"text":658},{"id":714,"depth":943,"text":715},{"id":805,"depth":940,"text":806,"children":965},[966,967,968,969,970,971,972],{"id":809,"depth":943,"text":810},{"id":819,"dept