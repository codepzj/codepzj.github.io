[{"data":1,"prerenderedAt":104},["ShallowReactive",2],{"content:\u002F2025\u002F11\u002Fwhat-is-webhook":3,"surround:\u002F2025\u002F11\u002Fwhat-is-webhook":93},{"id":4,"title":5,"body":6,"categories":70,"date":72,"description":73,"draft":74,"extension":75,"image":76,"meta":77,"navigation":79,"path":80,"permalink":76,"published":76,"readingTime":81,"recommend":76,"references":76,"seo":86,"sitemap":87,"stem":88,"tags":89,"type":91,"updated":72,"__hash__":92},"content\u002Fposts\u002F2025\u002F11\u002Fwhat-is-webhook.md","Webhook 工作原理与 Go 实现",{"type":7,"value":8,"toc":62},"minimark",[9,13,17,21,31,34,48,51],[10,11,12],"h2",{"id":12},"概念",[14,15,16],"p",{},"Webhook 属于一种事件驱动的消息推送机制。当特定事件被触发时，事件源会主动向预先配置的 webhook URL 发起 HTTP 请求。远程服务在收到请求后，会根据请求中携带的参数进行解析，并按照业务逻辑完成相应处理。",[10,18,20],{"id":19},"webhook-和-api-的区别","webhook 和 api 的区别",[22,23,24,28],"ul",{},[25,26,27],"li",{},"webhook 是主动推送的机制，主动向预设 url 发请求",[25,29,30],{},"api 是需要被动请求的，需要调用方手动请求",[10,32,33],{"id":33},"具体使用场景",[22,35,36,39,42,45],{},[25,37,38],{},"支付后，发送通知给商家出货",[25,40,41],{},"发博客后，主动发邮件",[25,43,44],{},"日志告警，主动发送到钉钉机器人",[25,46,47],{},"客服消息，主动推送到 n8n 工作流推送到飞书群",[10,49,50],{"id":50},"代码示例",[52,53,59],"pre",{"className":54,"code":56,"language":57,"meta":58},[55],"language-go","package main\n\nimport \"github.com\u002Fgin-gonic\u002Fgin\"\n\ntype WebhookRequest struct {\n    Event string `json:\"event\" binding:\"required\"`\n}\n\nfunc main() {\n    r := gin.Default()\n    r.POST(\"\u002Fwebhook\", func(c *gin.Context) {\n        var req WebhookRequest\n        if err := c.ShouldBindJSON(&req); err != nil {\n            c.JSON(400, gin.H{\"error\": err.Error()})\n            return\n        }\n        webhookEvent := req.Event\n        c.String(200, \"webhook event: %s\", webhookEvent)\n    })\n    r.Run(\":8080\")\n}\n","go","",[60,61,56],"code",{"__ignoreMap":58},{"title":58,"searchDepth":63,"depth":63,"links":64},4,[65,67,68,69],{"id":12,"depth":66,"text":12},2,{"id":19,"depth":66,"text":20},{"id":33,"depth":66,"text":33},{"id":50,"depth":66,"text":50},[71],"工程实践","2025-11-18","介绍 Webhook 的事件通知机制、典型使用场景，并使用 Go 和 Gin 实现简单的回调接口。",false,"md",null,{"slots":78},{},true,"\u002F2025\u002F11\u002Fwhat-is-webhook",{"text":82,"minutes":83,"time":84,"words":85},"2 min read",1.2,72000,240,{"title":5,"description":73},{"loc":80},"posts\u002F2025\u002F11\u002Fwhat-is-webhook",[90],"webhook","tech","BjZdIzK68x0ItlY2NcyjMQRm3M2vzh-g31yp76U1uz0",[94,99],{"title":95,"path":96,"stem":97,"date":98,"type":91,"children":-1},"GitLab Runner 使用与 CICD 全面指南","\u002F2025\u002F11\u002Fgitlab-ci","posts\u002F2025\u002F11\u002Fgitlab-ci","2025-11-10",{"title":100,"path":101,"stem":102,"date":103,"type":91,"children":-1},"短视频的推荐算法","\u002F2025\u002F12\u002Frecemmend-algorithm","posts\u002F2025\u002F12\u002Frecemmend-algorithm","2025-12-02",1786037979814]