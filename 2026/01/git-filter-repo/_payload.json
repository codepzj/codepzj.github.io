[{"data":1,"prerenderedAt":381},["ShallowReactive",2],{"content:\u002F2026\u002F01\u002Fgit-filter-repo":3,"surround:\u002F2026\u002F01\u002Fgit-filter-repo":370},{"id":4,"title":5,"body":6,"categories":347,"date":349,"description":350,"draft":351,"extension":352,"image":353,"meta":354,"navigation":356,"path":357,"permalink":353,"published":353,"readingTime":358,"recommend":353,"references":353,"seo":363,"sitemap":364,"stem":365,"tags":366,"type":368,"updated":349,"__hash__":369},"content\u002Fposts\u002F2026\u002F01\u002Fgit-filter-repo.md","git-filter-repo 清理敏感信息",{"type":7,"value":8,"toc":324},"minimark",[9,27,30,34,37,50,56,59,63,70,81,85,90,100,104,110,116,119,125,129,133,139,145,154,158,164,167,178,181,189,192,196,203,209,216,219,222,228,231,234,238,246,249,255,258,262,265,276,282,285,288,294,301,304,307,310,313,318],[10,11,12,13,17,18,21,22,26],"p",{},"在开发过程中，不小心把 ",[14,15,16],"code",{"code":16},"config.yaml","（包含Mysql，Redis 等配置）提交进了 Git 仓库。\n虽然随后通过提交把文件删除并加入了 ",[14,19,20],{"code":20},".gitignore","，但回过头来看，这个处理方式是",[23,24,25],"strong",{},"不完整的","。",[10,28,29],{},"原因很简单：\nGit 会永久保留历史提交，只要有人 checkout 到旧 commit，配置内容依然是明文可见的。",[31,32,33],"h2",{"id":33},"问题本质",[10,35,36],{},"很多人第一次遇到这个问题，都会下意识做这些操作：",[38,39,40,44,47],"ul",{},[41,42,43],"li",{},"删除配置文件再提交",[41,45,46],{},"新增提交覆盖旧内容",[41,48,49],{},"revert 某个提交",[10,51,52,53],{},"这些方式的共同问题是：\n",[23,54,55],{},"它们只影响当前分支状态，不会影响 Git 历史中的对象。",[10,57,58],{},"只要配置文件曾经被提交过，就必须假设已经泄露。",[31,60,62],{"id":61},"为什么要用-git-filter-repo","为什么要用 git-filter-repo",[10,64,65,66,69],{},"目前官方推荐的是 ",[14,67,68],{"code":68},"git-filter-repo","，专门用于：",[38,71,72,75,78],{},[41,73,74],{},"清理敏感文件",[41,76,77],{},"重写提交历史",[41,79,80],{},"仓库级别维护操作",[31,82,84],{"id":83},"安装-git-filter-repo","安装 git-filter-repo",[86,87,89],"h3",{"id":88},"macos","macOS",[91,92,98],"pre",{"className":93,"code":95,"language":96,"meta":97},[94],"language-bash","brew install git-filter-repo\n","bash","",[14,99,95],{"__ignoreMap":97},[86,101,103],{"id":102},"linux","Linux",[91,105,108],{"className":106,"code":107,"language":96,"meta":97},[94],"pip3 install --user git-filter-repo\n",[14,109,107],{"__ignoreMap":97},[91,111,114],{"className":112,"code":113,"language":96,"meta":97},[94],"~\u002F.local\u002Fbin\u002Fgit-filter-repo --help\n",[14,115,113],{"__ignoreMap":97},[10,117,118],{},"如果提示找不到命令，把路径加入 PATH：",[91,120,123],{"className":121,"code":122,"language":96,"meta":97},[94],"export PATH=$PATH:~\u002F.local\u002Fbin\n",[14,124,122],{"__ignoreMap":97},[31,126,128],{"id":127},"如何使用-git-filter-repo-清理敏感信息","如何使用 git-filter-repo 清理敏感信息",[86,130,132],{"id":131},"_1-使用-mirror-方式克隆仓库","1. 使用 mirror 方式克隆仓库",[91,134,137],{"className":135,"code":136,"language":96,"meta":97},[94],"git clone --mirror https:\u002F\u002Fgithub.com\u002Fcodepzj\u002Fdemo-repo.git demo-repo-mirror\ncd demo-repo-mirror\n",[14,138,136],{"__ignoreMap":97},[10,140,141,144],{},[14,142,143],{"code":143},"--mirror"," 的目的不是开发，而是为了：",[146,147,148,151],"ol",{},[41,149,150],{},"包含所有分支、tag、引用",[41,152,153],{},"确保不会遗漏任何历史",[86,155,157],{"id":156},"_2-从所有历史提交中移除配置文件","2. 从所有历史提交中移除配置文件",[91,159,162],{"className":160,"code":161,"language":96,"meta":97},[94],"git filter-repo --path config.yaml --invert-paths\n",[14,163,161],{"__ignoreMap":97},[10,165,166],{},"执行完成后，git-filter-repo 会：",[38,168,169,172,175],{},[41,170,171],{},"重写所有提交",[41,173,174],{},"删除旧的 blob 对象",[41,176,177],{},"重新打包仓库对象",[10,179,180],{},"如果看到类似：",[91,182,187],{"className":183,"code":185,"language":186,"meta":97},[184],"language-text","Parsed 15 commits\nNew history written\nRepacking your repo\n","text",[14,188,185],{"__ignoreMap":97},[10,190,191],{},"说明处理是成功的。",[86,193,195],{"id":194},"_3-重新添加远端并覆盖推送","3. 重新添加远端并覆盖推送",[10,197,198,199,202],{},"git-filter-repo 会主动移除 ",[14,200,201],{"code":201},"origin","，这是为了防止误推送。",[91,204,207],{"className":205,"code":206,"language":96,"meta":97},[94],"git remote add origin https:\u002F\u002Fgithub.com\u002Fcodepzj\u002Fdemo-repo.git\ngit push --force --mirror\n",[14,208,206],{"__ignoreMap":97},[10,210,211,212,215],{},"这一步会直接用",[23,213,214],{},"新的干净历史","替换远端仓库。",[31,217,218],{"id":218},"如何确认是否真的清理干净",[10,220,221],{},"在任意新 clone 的仓库中执行：",[91,223,226],{"className":224,"code":225,"language":96,"meta":97},[94],"git log --all -- config.yaml\n",[14,227,225],{"__ignoreMap":97},[10,229,230],{},"如果没有任何输出，说明该文件已经不存在于历史中。",[31,232,233],{"id":233},"必须做的后续处理",[86,235,237],{"id":236},"_1-永久忽略该配置文件","1. 永久忽略该配置文件",[91,239,244],{"className":240,"code":242,"language":243,"meta":97},[241],"language-gitignore","config.yaml\n","gitignore",[14,245,242],{"__ignoreMap":97},[10,247,248],{},"同时提供示例文件：",[91,250,253],{"className":251,"code":252,"language":186,"meta":97},[184],"config.example.yaml\n",[14,254,252],{"__ignoreMap":97},[10,256,257],{},"只放结构，不放真实值。",[86,259,261],{"id":260},"_2-重置所有相关密钥","2. 重置所有相关密钥",[10,263,264],{},"无论泄露时间长短，都应视为已暴露：",[38,266,267,270,273],{},[41,268,269],{},"数据库账号密码",[41,271,272],{},"JWT Secret",[41,274,275],{},"Firebase \u002F 云服务凭证",[10,277,278,279,26],{},"历史清理只能解决 Git 层面的问题，",[23,280,281],{},"无法撤回已经泄露的密钥",[31,283,284],{"id":284},"多人协作需要注意的点",[10,286,287],{},"历史被重写后，所有协作者必须同步仓库状态：",[91,289,292],{"className":290,"code":291,"language":96,"meta":97},[94],"git fetch --all\ngit reset --hard origin\u002Fmain\n",[14,293,291],{"__ignoreMap":97},[10,295,296,297,300],{},"如果有人直接 ",[14,298,299],{"code":299},"git pull"," 并再次推送，旧历史可能会被带回远端。",[31,302,303],{"id":303},"总结",[10,305,306],{},"这次问题的根源不是 Git 操作失误，而是：",[10,308,309],{},"对 Git 历史不可变性的低估。",[10,311,312],{},"只要敏感信息进入过仓库，正确的处理方式只有一种：",[10,314,315],{},[23,316,317],{},"重写历史，而不是覆盖提交。",[10,319,320,323],{},[14,321,322],{"code":322},"git filter-repo + mirror + force push","是目前最稳妥、最可控的一套方案。",{"title":97,"searchDepth":325,"depth":325,"links":326},4,[327,329,330,335,340,341,345,346],{"id":33,"depth":328,"text":33},2,{"id":61,"depth":328,"text":62},{"id":83,"depth":328,"text":84,"children":331},[332,334],{"id":88,"depth":333,"text":89},3,{"id":102,"depth":333,"text":103},{"id":127,"depth":328,"text":128,"children":336},[337,338,339],{"id":131,"depth":333,"text":132},{"id":156,"depth":333,"text":157},{"id":194,"depth":333,"text":195},{"id":218,"depth":328,"text":218},{"id":233,"depth":328,"text":233,"children":342},[343,344],{"id":236,"depth":333,"text":237},{"id":260,"depth":333,"text":261},{"id":284,"depth":328,"text":284},{"id":303,"depth":328,"text":303},[348],"工程实践","2026-01-21","git-filter-repo清理敏感信息，防止git提交了敏感信息后导致的密钥泄漏",false,"md",null,{"slots":355},{},true,"\u002F2026\u002F01\u002Fgit-filter-repo",{"text":359,"minutes":360,"time":361,"words":362},"4 min read",3.63,217800,726,{"title":5,"description":350},{"loc":357},"posts\u002F2026\u002F01\u002Fgit-filter-repo",[367],"git","tech","LxwsU6mP6q08rfhoedr96QAvDQFzH_ELGdui7V4qKJE",[371,376],{"title":372,"path":373,"stem":374,"date":375,"type":368,"children":-1},"gRPC Metadata 的传递与使用","\u002F2026\u002F01\u002Fgrpc-metadata","posts\u002F2026\u002F01\u002Fgrpc-metadata","2026-01-05",{"title":377,"path":378,"stem":379,"date":380,"type":368,"children":-1},"Github CI自动发版","\u002F2026\u002F02\u002Fgit-semantic-release","posts\u002F2026\u002F02\u002Fgit-semantic-release","2026-02-15",1786037979478]