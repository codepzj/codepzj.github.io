[{"data":1,"prerenderedAt":250},["ShallowReactive",2],{"content:\u002F2026\u002F01\u002Fgrpc-metadata":3,"surround:\u002F2026\u002F01\u002Fgrpc-metadata":239},{"id":4,"title":5,"body":6,"categories":214,"date":216,"description":217,"draft":218,"extension":219,"image":220,"meta":221,"navigation":223,"path":224,"permalink":220,"published":220,"readingTime":225,"recommend":220,"references":220,"seo":230,"sitemap":231,"stem":232,"tags":233,"type":236,"updated":237,"__hash__":238},"content\u002Fposts\u002F2026\u002F01\u002Fgrpc-metadata.md","gRPC Metadata 的传递与使用",{"type":7,"value":8,"toc":194},"minimark",[9,13,33,36,47,54,57,62,68,81,85,92,98,102,105,111,114,120,124,127,133,143,146,152,168,171,183,186],[10,11,12],"h2",{"id":12},"什么是metadata",[14,15,16],"blockquote",{},[17,18,19,20,24,25,28,29,32],"p",{},"metadata即为元信息，记录k、v键值对，类似于http请求当中的header，常用于RPC请求当中的鉴权、追溯和验签等场景，元数据可以包含",[21,22,23],"strong",{},"认证token","、",[21,26,27],{},"请求标识","和",[21,30,31],{},"监控标签","等",[17,34,35],{},"metadata的数据类型",[37,38,44],"pre",{"className":39,"code":41,"language":42,"meta":43},[40],"language-go","type MD map[string][]string\n","go","",[45,46,41],"code",{"__ignoreMap":43},[17,48,49,50,53],{},"元数据可以像普通map一样读取。注意，这个 map 的值类型是",[51,52],"span",{},"string，因此用户可以使用一个键附加多个值。",[10,55,56],{"id":56},"创建metadata",[58,59,61],"h3",{"id":60},"metadatapairs","metadata.Pairs",[37,63,66],{"className":64,"code":65,"language":42,"meta":43},[40],"md := metadata.Pairs(\n    \"x-token\", \"codepzj-authorization-key\",\n    \"X-TOKEN\", \"codepzj-authorization-key-2\",\n    \"req_id\", \"req_123456\",\n)\n",[45,67,65],{"__ignoreMap":43},[17,69,70,71,28,74,77,78],{},"需要注意的是key是大小写不敏感的，",[45,72,73],{"code":73},"x-token",[45,75,76],{"code":76},"X-TOKEN","会被识别为同一个key，最终值为",[45,79,80],{"code":80},"[\"codepzj-authorization-key\", \"codepzj-authorization-key-2\"]",[58,82,84],{"id":83},"kv字符串","k、v字符串",[17,86,87,88,91],{},"在客户端发起调用的时候，以k、v字符串附加到",[45,89,90],{"code":90},"AppendToOutgoingContext","之后",[37,93,96],{"className":94,"code":95,"language":42,"meta":43},[40],"ctx := metadata.AppendToOutgoingContext(context.Background(), \"x-token\", \"codepzj-authorization-key\", \"req_id\", \"req_123456\")\n",[45,97,95],{"__ignoreMap":43},[10,99,101],{"id":100},"客户端发送metadata服务端接收metadata","客户端发送metadata，服务端接收metadata",[58,103,104],{"id":104},"client",[37,106,109],{"className":107,"code":108,"language":42,"meta":43},[40],"ctx := metadata.AppendToOutgoingContext(context.Background(), \"x-token\", \"codepzj-authorization-key\", \"req_id\", \"req_123456\")\n\nresp, err := client.SayHello(ctx, &pb.HelloRequest{Name: *name})\n",[45,110,108],{"__ignoreMap":43},[58,112,113],{"id":113},"server",[37,115,118],{"className":116,"code":117,"language":42,"meta":43},[40],"\u002F\u002F 1. 接受来自客户端的metadata\nmd, ok := metadata.FromIncomingContext(ctx)\nif !ok {\n    return nil, status.Error(codes.Unauthenticated, \"metadata missing\")\n}\n\nlog.Printf(\"md: %+v\\n\", md)\n\n\u002F\u002F 2. 解析metadata\nxToken, ok := md[\"x-token\"]\nif !ok {\n    return nil, status.Error(codes.Unauthenticated, \"x-token missing\")\n}\nif len(xToken) == 0 {\n    return nil, status.Error(codes.Unauthenticated, \"x-token missing\")\n}\n\nlog.Println(\"x-token\", xToken[0])\n",[45,119,117],{"__ignoreMap":43},[10,121,123],{"id":122},"服务端发送metadata客户端接收metadata","服务端发送metadata，客户端接收metadata",[58,125,113],{"id":126},"server-1",[37,128,131],{"className":129,"code":130,"language":42,"meta":43},[40],"\u002F\u002F 3. 服务端设置metadata, 发送给客户端\nheader := metadata.Pairs(\"x-server\", \"ok\")\nif err := grpc.SendHeader(ctx, header); err != nil {\n    log.Println(\"Failed to set header from SayHello\")\n}\ndefer func() {\n    trailer := metadata.Pairs(\"x-trailer\", \"ok\")\n    if err := grpc.SetTrailer(ctx, trailer); err != nil {\n        log.Println(\"Failed to set trailer from SayHello\")\n    }\n}()\n",[45,132,130],{"__ignoreMap":43},[17,134,135,136,139,140],{},"直接",[45,137,138],{"code":138},"grpc.SendHeader"," & ",[45,141,142],{"code":142},"grpc.SetTrailer",[58,144,104],{"id":145},"client-1",[37,147,150],{"className":148,"code":149,"language":42,"meta":43},[40],"var header, trailer metadata.MD\nresp, err := client.SayHello(ctx, &pb.HelloRequest{Name: *name}, grpc.Header(&header), grpc.Trailer(&trailer))\nif err != nil {\n    log.Fatalf(\"failed to call SayHello: %v\", err)\n}\nlog.Printf(\"Response: %s\", resp.Message)\nlog.Printf(\"Header: %s\", header)\n",[45,151,149],{"__ignoreMap":43},[17,153,154,155,158,159,162,163,158,165,167],{},"在发请求前绑定",[45,156,157],{"code":157},"header"," OR ",[45,160,161],{"code":161},"trailer","，收到server响应就绑定到",[45,164,157],{"code":157},[45,166,161],{"code":161},"上了",[10,169,170],{"id":170},"参考文章",[172,173,174],"ul",{},[175,176,177],"li",{},[178,179,180],"a",{"href":180,"rel":181},"https:\u002F\u002Fliwenzhou.com\u002Fposts\u002FGo\u002FgRPC\u002F",[182],"nofollow",[10,184,185],{"id":185},"代码仓库",[172,187,188],{},[175,189,190],{},[178,191,192],{"href":192,"rel":193},"https:\u002F\u002Fcnb.cool\u002Fcodepzj\u002Fgoplayground\u002F-\u002Ftree\u002Fmain\u002Frpc-learn\u002Fgrpc-metadata",[182],{"title":43,"searchDepth":195,"depth":195,"links":196},4,[197,199,204,208,212,213],{"id":12,"depth":198,"text":12},2,{"id":56,"depth":198,"text":56,"children":200},[201,203],{"id":60,"depth":202,"text":61},3,{"id":83,"depth":202,"text":84},{"id":100,"depth":198,"text":101,"children":205},[206,207],{"id":104,"depth":202,"text":104},{"id":113,"depth":202,"text":113},{"id":122,"depth":198,"text":123,"children":209},[210,211],{"id":126,"depth":202,"text":113},{"id":145,"depth":202,"text":104},{"id":170,"depth":198,"text":170},{"id":185,"depth":198,"text":185},[215],"微服务","2026-01-05","介绍 gRPC Metadata 的创建、发送和读取方法，以及 Header、Trailer 在客户端与服务端之间的传递。",false,"md",null,{"slots":222},{},true,"\u002F2026\u002F01\u002Fgrpc-metadata",{"text":226,"minutes":227,"time":228,"words":229},"2 min read",1.995,119700,399,{"title":5,"description":217},{"loc":224},"posts\u002F2026\u002F01\u002Fgrpc-metadata",[234,235],"gRPC","Metadata","tech","2026-01-07","OirJUeM49NYGrZUo4qv3nclx2hKtem4iV3MR8y0rXtw",[240,245],{"title":241,"path":242,"stem":243,"date":244,"type":236,"children":-1},"使用 Go 构建第一个 gRPC 服务","\u002F2026\u002F01\u002Fgrpc-hello-demo","posts\u002F2026\u002F01\u002Fgrpc-hello-demo","2026-01-01",{"title":246,"path":247,"stem":248,"date":249,"type":236,"children":-1},"git-filter-repo 清理敏感信息","\u002F2026\u002F01\u002Fgit-filter-repo","posts\u002F2026\u002F01\u002Fgit-filter-repo","2026-01-21",1786037979518]