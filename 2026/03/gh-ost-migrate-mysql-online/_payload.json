[{"data":1,"prerenderedAt":574},["ShallowReactive",2],{"content:\u002F2026\u002F03\u002Fgh-ost-migrate-mysql-online":3,"surround:\u002F2026\u002F03\u002Fgh-ost-migrate-mysql-online":563},{"id":4,"title":5,"body":6,"categories":539,"date":541,"description":542,"draft":543,"extension":544,"image":545,"meta":546,"navigation":548,"path":549,"permalink":545,"published":545,"readingTime":550,"recommend":545,"references":545,"seo":555,"sitemap":556,"stem":557,"tags":558,"type":560,"updated":561,"__hash__":562},"content\u002Fposts\u002F2026\u002F03\u002Fgh-ost-migrate-mysql-online.md","千万级 Mysql 表结构变更实战",{"type":7,"value":8,"toc":525},"minimark",[9,22,38,41,44,52,56,65,75,85,91,100,106,127,133,136,157,164,172,196,199,202,210,213,216,222,225,231,234,240,243,249,253,258,261],[10,11,12,13,17,18,21],"p",{},"在生产环境中，对千万级数据表直接执行 ",[14,15,16],"code",{"code":16},"ALTER TABLE"," 进行结构修改，往往会导致表被锁定，从而阻塞写入操作，可能造成数据不一致或业务停顿。为了安全、无感知地变更大表结构，",[14,19,20],{"code":20},"gh-ost"," 提供了一种高效、零停机的解决方案。",[10,23,24,25,29,30,33,34,37],{},"它通过创建",[26,27,28],"strong",{},"镜像表","、",[26,31,32],{},"全量+增量同步数据","，最终使用",[26,35,36],{},"原子级别的表重命名切换","完成变更。整个过程可以随时暂停，对业务几乎无影响，非常适合 500 万条以上的大表操作。",[39,40,20],"h2",{"id":20},[10,42,43],{},"生产环境最常用, 适用于 500 万条数据以上",[10,45,46],{},[47,48,49],"a",{"href":49,"rel":50},"https:\u002F\u002Fgithub.com\u002Fgithub\u002Fgh-ost",[51],"nofollow",[53,54,55],"h3",{"id":55},"工作原理",[57,58,59],"ol",{},[60,61,62,63],"li",{},"创建",[26,64,28],{},[66,67,73],"pre",{"className":68,"code":70,"language":71,"meta":72},[69],"language-text","t_dir_gho\n","text","",[14,74,70],{"__ignoreMap":72},[57,76,78],{"start":77},2,[60,79,80,81,84],{},"同步原表数据(",[14,82,83],{"code":83},"t_dir",")",[66,86,89],{"className":87,"code":88,"language":71,"meta":72},[69],"copy data\n",[14,90,88],{"__ignoreMap":72},[57,92,94],{"start":93},3,[60,95,96,99],{},[14,97,98],{"code":98},"binlog"," 增量同步",[66,101,104],{"className":102,"code":103,"language":71,"meta":72},[69],"实时同步变更\n",[14,105,103],{"__ignoreMap":72},[57,107,109],{"start":108},4,[60,110,111,112,115,116,118,119,115,122,118,125],{},"最终 ",[26,113,114],{},"原子切换",", 将 ",[14,117,83],{"code":83}," 重命名为 ",[14,120,121],{"code":121},"t_dir_old",[14,123,124],{"code":124},"t_dir_gho",[14,126,83],{"code":83},[66,128,131],{"className":129,"code":130,"language":71,"meta":72},[69],"rename table\n",[14,132,130],{"__ignoreMap":72},[10,134,135],{},"优点：",[137,138,139,142,151,154],"ul",{},[60,140,141],{},"rename 表是原子操作",[60,143,144,147,148,150],{},[26,145,146],{},"不停写,"," 因为是镜像表的缘故,除了全量同步,同时通过 ",[14,149,98],{"code":98}," 订阅原表对镜像表进行增量同步",[60,152,153],{},"可随时暂停",[60,155,156],{},"对业务无感",[10,158,159,160,163],{},"实际上在表切换的过程中,执行的以下 ",[14,161,162],{"code":162},"Sql"," 语句",[66,165,170],{"className":166,"code":168,"language":169,"meta":72},[167],"language-sql","RENAME TABLE t_dir TO t_dir_old,t_dir_new TO t_dir;\n","sql",[14,171,168],{"__ignoreMap":72},[10,173,174,175,178,179,182,183,186,187,189,190,192,193,195],{},"切换的时间",[14,176,177],{"code":177},"\u003C 1ms",",在这 ",[14,180,181],{"code":181},"1ms","中 ",[14,184,185],{"code":185},"Rename","会锁表,假如说这一瞬间对原表(",[14,188,83],{"code":83},")进行写操作,那么会短暂停顿等待切换后的\"",[14,191,83],{"code":83},"\"释放锁, 所以并不会造成数据丢失, 而且这",[14,194,181],{"code":181},"很短,对业务无感",[39,197,198],{"id":198},"常见使用示例",[53,200,201],{"id":201},"添加索引",[66,203,208],{"className":204,"code":206,"language":207,"meta":72},[205],"language-bash","gh-ost \\\n--host=127.0.0.1 \\\n--user=root \\\n--password=123456 \\\n--database=db \\\n--table=t_dir \\\n--alter=\"ADD INDEX idx_uid(uid)\" \\\n--allow-on-master \\\n--execute\n","bash",[14,209,206],{"__ignoreMap":72},[53,211,212],{"id":212},"修改字段类型",[10,214,215],{},"例如：",[66,217,220],{"className":218,"code":219,"language":207,"meta":72},[205],"INT → BIGINT\ngh-ost \\\n--host=127.0.0.1 \\\n--user=root \\\n--password=123456 \\\n--database=db \\\n--table=t_dir \\\n--alter=\"MODIFY COLUMN uid BIGINT\" \\\n--allow-on-master \\\n--execute\n",[14,221,219],{"__ignoreMap":72},[53,223,224],{"id":224},"添加字段",[66,226,229],{"className":227,"code":228,"language":207,"meta":72},[205],"gh-ost \\\n--host=127.0.0.1 \\\n--user=root \\\n--password=123456 \\\n--database=db \\\n--table=t_dir \\\n--alter=\"ADD COLUMN status INT NOT NULL DEFAULT 0\" \\\n--allow-on-master \\\n--execute\n",[14,230,228],{"__ignoreMap":72},[53,232,233],{"id":233},"删除字段",[66,235,238],{"className":236,"code":237,"language":207,"meta":72},[205],"gh-ost \\\n--host=127.0.0.1 \\\n--user=root \\\n--password=123456 \\\n--database=db \\\n--table=t_dir \\\n--alter=\"DROP COLUMN temp_field\" \\\n--allow-on-master \\\n--execute\n",[14,239,237],{"__ignoreMap":72},[53,241,242],{"id":242},"重命名字段",[66,244,247],{"className":245,"code":246,"language":207,"meta":72},[205],"gh-ost \\\n--host=127.0.0.1 \\\n--user=root \\\n--password=123456 \\\n--database=db \\\n--table=t_dir \\\n--alter=\"CHANGE old_name new_name VARCHAR(255)\" \\\n--allow-on-master \\\n--execute\n",[14,248,246],{"__ignoreMap":72},[53,250,252],{"id":251},"添加-not-null-字段","添加 NOT NULL 字段",[66,254,256],{"className":255,"code":228,"language":207,"meta":72},[205],[14,257,228],{"__ignoreMap":72},[53,259,260],{"id":260},"常用参数说明",[262,263,264,280],"table",{},[265,266,267],"thead",{},[268,269,270,274,277],"tr",{},[271,272,273],"th",{},"参数",[271,275,276],{},"说明",[271,278,279],{},"示例",[281,282,283,299,314,329,344,359,373,388,401,414,429,444,459,474,487,499,512],"tbody",{},[268,284,285,291,294],{},[286,287,288],"td",{},[14,289,290],{"code":290},"--host",[286,292,293],{},"MySQL 地址",[286,295,296],{},[14,297,298],{"code":298},"127.0.0.1",[268,300,301,306,309],{},[286,302,303],{},[14,304,305],{"code":305},"--port",[286,307,308],{},"MySQL 端口",[286,310,311],{},[14,312,313],{"code":313},"3306",[268,315,316,321,324],{},[286,317,318],{},[14,319,320],{"code":320},"--user",[286,322,323],{},"数据库用户名",[286,325,326],{},[14,327,328],{"code":328},"root",[268,330,331,336,339],{},[286,332,333],{},[14,334,335],{"code":335},"--password",[286,337,338],{},"数据库密码",[286,340,341],{},[14,342,343],{"code":343}