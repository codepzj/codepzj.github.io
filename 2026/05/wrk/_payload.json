Name":441},[409],[348,443,386],{"className":444},[409,410],"(标准差\u002F平均值)",[288,447,448,458],{},[291,449,450],{},[294,451,452,455],{},[297,453,454],{},"CV",[297,456,457],{},"结论",[309,459,460,468,476,484],{},[294,461,462,465],{},[314,463,464],{},"\u003C 0.3",[314,466,467],{},"稳定",[294,469,470,473],{},[314,471,472],{},"0.3~0.5",[314,474,475],{},"有波动",[294,477,478,481],{},[314,479,480],{},"> 0.5",[314,482,483],{},"不稳定",[294,485,486,489],{},[314,487,488],{},"> 1",[314,490,491],{},"过载",[166,493,494],{"id":494},"平均延迟",[34,496,497],{},"只能作为参考",[288,499,500,513],{},[291,501,502],{},[294,503,504,507,510],{},[297,505,506],{},"延迟（Avg \u002F P50）",[297,508,509],{},"评价",[297,511,512],{},"说明",[309,514,515,528,540,553,566,579,592],{},[294,516,517,522,525],{},[314,518,519],{},[189,520,521],{},"\u003C 10ms",[314,523,524],{},"极优",[314,526,527],{},"内存级 \u002F 本地缓存",[294,529,530,535,537],{},[314,531,532],{},[189,533,534],{},"10 ~ 50ms",[314,536,302],{},[314,538,539],{},"高频接口理想状态",[294,541,542,547,550],{},[314,543,544],{},[189,545,546],{},"50 ~ 100ms",[314,548,549],{},"良好",[314,551,552],{},"常规业务推荐范围",[294,554,555,560,563],{},[314,556,557],{},[189,558,559],{},"100 ~ 200ms",[314,561,562],{},"一般",[314,564,565],{},"用户开始能感知",[294,567,568,573,576],{},[314,569,570],{},[189,571,572],{},"200 ~ 500ms",[314,574,575],{},"较差",[314,577,578],{},"明显变慢",[294,580,581,586,589],{},[314,582,583],{},[189,584,585],{},"500ms ~ 1s",[314,587,588],{},"很差",[314,590,591],{},"用户明显卡顿",[294,593,594,598,601],{},[314,595,596],{},[189,597,341],{},[314,599,600],{},"不可接受",[314,602,603],{},"必须优化",[166,605,606],{"id":606},"业界通用指标",[14,608,611],{"className":609,"code":610,"language":19,"meta":20},[17],"✔ 错误率 ≈ 0\n✔ P99 在可控范围(200ms以下)\n✔ CV \u003C 0.3（稳定）\n✔ QPS 在目标负载下稳定\n",[22,612,610],{"__ignoreMap":20},[34,614,615,616,619],{},"保证上述的同时，选择合适的线程数(与电脑的 CPU 数量有关),渐进式增大 ",[22,617,618],{"code":618},"c","，找到该接口的最大拐点，测出稳定状态下的最大请求数量",[34,621,622],{},"在不断调整下",[14,624,627],{"className":625,"code":626,"language":19,"meta":20},[17],"pzj@pzjmac ~ % wrk -c18 -d10s -t10 --latency https:\u002F\u002Fblog-api.golangblog.com\u002Fconfig\u002Fhome \nRunning 10s test @ https:\u002F\u002Fblog-api.golangblog.com\u002Fconfig\u002Fhome\n  10 threads and 18 connections\n  Thread Stats   Avg      Stdev     Max   +\u002F- Stdev\n    Latency    76.36ms   13.38ms 168.20ms   81.25%\n    Req\u002FSec    12.84      4.84    20.00     65.91%\n  Latency Distribution\n     50%   71.89ms\n     75%   78.84ms\n     90%   96.56ms\n     99%  121.26ms\n  1307 requests in 10.09s, 2.11MB read\nRequests\u002Fsec:    129.56\nTransfer\u002Fsec:    213.71KB\n",[22,628,626],{"__ignoreMap":20},[34,630,631,632,635],{},"得到博客在稳定状态下最大 QPS 为 129，使用裸 ip 的 QPS 大约在 220 左右，主要原因是",[22,633,634],{"code":634},"TLS \u002F HTTPS"," 的开销",[10,637,638],{"id":638},"总结",[34,640,641],{},"性能测试的目标不是跑高数据，而是找到系统在“稳定 + 可用”前提下的真实上限。",{"title":20,"searchDepth":643,"depth":643,"links":644},4,[645,647,648,649,650,658],{"id":12,"depth":646,"text":12},2,{"id":26,"depth":646,"text":26},{"id":66,"depth":646,"text":66},{"id":95,"depth":646,"text":95},{"id":158,"depth":646,"text":158,"children":651},[652,654,655,656,657],{"id":168,"depth":653,"text":168},3,{"id":213,"depth":653,"text":213},{"id":344,"depth":653,"text":344},{"id":494,"depth":653,"text":494},{"id":606,"depth":653,"text":606},{"id":638,"depth":646,"text":638},[660],"工程实践","2026-05-06","本文围绕 wrk 压测工具展开，从基础使用到结果分析，结合错误率、尾延迟（P95\u002FP99）、稳定性等核心指标，给出一套可落地的评估方法，用于定位系统性能瓶颈并计算稳定状态下的最大可承载吞吐量。",false,"md",null,{"slots":667},{},true,"\u002F2026\u002F05\u002Fwrk",{"text":671,"minutes":672,"time":673,"words":674},"5 min read",4.395,263700,879,{"title":5,"description":662},{"loc":669},"posts\u002F2026\u002F05\u002Fwrk",[272],"tech","2026-06-10","nxVKQBHBZ44Ph93cSSvGbphEidJ6m2hhkfTYm6RBC9Q",[683,688],{"title":684,"path":685,"stem":686,"date":687,"type":679,"children":-1},"VS Code 中配置 Protobuf 开发环境","\u002F2026\u002F04\u002Fkratos-vscode-proto","posts\u002F2026\u002F04\u002Fkratos-vscode-proto","2026-04-12",{"title":689,