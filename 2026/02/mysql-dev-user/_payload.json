[{"data":1,"prerenderedAt":223},["ShallowReactive",2],{"content:\u002F2026\u002F02\u002Fmysql-dev-user":3,"surround:\u002F2026\u002F02\u002Fmysql-dev-user":213},{"id":4,"title":5,"body":6,"categories":189,"date":191,"description":192,"draft":193,"extension":194,"image":195,"meta":196,"navigation":198,"path":199,"permalink":195,"published":195,"readingTime":200,"recommend":195,"references":195,"seo":205,"sitemap":206,"stem":207,"tags":208,"type":211,"updated":191,"__hash__":212},"content\u002Fposts\u002F2026\u002F02\u002Fmysql-dev-user.md","MySQL 用户与权限管理",{"type":7,"value":8,"toc":170},"minimark",[9,18,23,28,39,42,48,52,58,71,75,78,84,87,93,97,103,109,113,116,122,126,132,136,142,146],[10,11,12,13,17],"p",{},"在 MySQL 中创建用户并授权，标准流程分为三步：",[14,15,16],"strong",{},"创建用户 → 授权 → 刷新权限","。",[19,20,22],"h2",{"id":21},"一创建用户","一、创建用户",[24,25,27],"h3",{"id":26},"允许任意-ip-访问","允许任意 IP 访问",[29,30,36],"pre",{"className":31,"code":33,"language":34,"meta":35},[32],"language-sql","CREATE USER 'username'@'%' IDENTIFIED BY 'password';\n","sql","",[37,38,33],"code",{"__ignoreMap":35},[24,40,41],{"id":41},"只允许本机访问",[29,43,46],{"className":44,"code":45,"language":34,"meta":35},[32],"CREATE USER 'username'@'localhost' IDENTIFIED BY 'password';\n",[37,47,45],{"__ignoreMap":35},[24,49,51],{"id":50},"指定某个-ip","指定某个 IP",[29,53,56],{"className":54,"code":55,"language":34,"meta":35},[32],"CREATE USER 'username'@'192.168.1.100' IDENTIFIED BY 'password';\n",[37,57,55],{"__ignoreMap":35},[59,60,61],"blockquote",{},[10,62,63,66,67,70],{},[37,64,65],{"code":65},"%"," 表示任意主机\n",[37,68,69],{"code":69},"localhost"," 表示仅本机",[19,72,74],{"id":73},"二授予权限","二、授予权限",[24,76,77],{"id":77},"授予某个数据库全部权限",[29,79,82],{"className":80,"code":81,"language":34,"meta":35},[32],"GRANT ALL PRIVILEGES ON db_name.* TO 'username'@'%';\n",[37,83,81],{"__ignoreMap":35},[24,85,86],{"id":86},"只授予常用权限",[29,88,91],{"className":89,"code":90,"language":34,"meta":35},[32],"GRANT SELECT, INSERT, UPDATE, DELETE ON db_name.* TO 'username'@'%';\n",[37,92,90],{"__ignoreMap":35},[24,94,96],{"id":95},"授予所有数据库权限慎用","授予所有数据库权限(慎用)",[29,98,101],{"className":99,"code":100,"language":34,"meta":35},[32],"GRANT ALL PRIVILEGES ON *.* TO 'username'@'%' WITH GRANT OPTION;\n",[37,102,100],{"__ignoreMap":35},[10,104,105,108],{},[37,106,107],{"code":107},"WITH GRANT OPTION"," 表示该用户可以再给别人授权。",[19,110,112],{"id":111},"三刷新权限","三、刷新权限",[10,114,115],{},"MySQL 8.0 一般不需要手动刷新，但可以执行：",[29,117,120],{"className":118,"code":119,"language":34,"meta":35},[32],"FLUSH PRIVILEGES;\n",[37,121,119],{"__ignoreMap":35},[19,123,125],{"id":124},"四查看权限","四、查看权限",[29,127,130],{"className":128,"code":129,"language":34,"meta":35},[32],"SHOW GRANTS FOR 'username'@'%';\n",[37,131,129],{"__ignoreMap":35},[19,133,135],{"id":134},"五删除用户","五、删除用户",[29,137,140],{"className":138,"code":139,"language":34,"meta":35},[32],"DROP USER 'username'@'%';\n",[37,141,139],{"__ignoreMap":35},[19,143,145],{"id":144},"六生产环境建议","六、生产环境建议",[147,148,149,153,159,162,165],"ul",{},[150,151,152],"li",{},"不要使用 root 账号对外提供服务",[150,154,155,156],{},"不要轻易使用 ",[37,157,158],{"code":158},"*.*",[150,160,161],{},"一个服务一个数据库用户",[150,163,164],{},"最小权限原则",[150,166,167,168],{},"生产库不要开",[37,169,65],{"code":65},{"title":35,"searchDepth":171,"depth":171,"links":172},4,[173,180,185,186,187,188],{"id":21,"depth":174,"text":22,"children":175},2,[176,178,179],{"id":26,"depth":177,"text":27},3,{"id":41,"depth":177,"text":41},{"id":50,"depth":177,"text":51},{"id":73,"depth":174,"text":74,"children":181},[182,183,184],{"id":77,"depth":177,"text":77},{"id":86,"depth":177,"text":86},{"id":95,"depth":177,"text":96},{"id":111,"depth":174,"text":112},{"id":124,"depth":174,"text":125},{"id":134,"depth":174,"text":135},{"id":144,"depth":174,"text":145},[190],"数据库","2026-02-18","整理 MySQL 用户创建、授权、权限查看、权限刷新和用户删除等常用管理操作。",false,"md",null,{"slots":197},{},true,"\u002F2026\u002F02\u002Fmysql-dev-user",{"text":201,"minutes":202,"time":203,"words":204},"2 min read",1.22,73200,244,{"title":5,"description":192},{