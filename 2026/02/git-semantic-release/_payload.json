[{"data":1,"prerenderedAt":174},["ShallowReactive",2],{"content:\u002F2026\u002F02\u002Fgit-semantic-release":3,"surround:\u002F2026\u002F02\u002Fgit-semantic-release":164},{"id":4,"title":5,"body":6,"categories":140,"date":142,"description":143,"draft":144,"extension":145,"image":146,"meta":147,"navigation":149,"path":150,"permalink":146,"published":146,"readingTime":151,"recommend":146,"references":146,"seo":156,"sitemap":157,"stem":158,"tags":159,"type":161,"updated":162,"__hash__":163},"content\u002Fposts\u002F2026\u002F02\u002Fgit-semantic-release.md","Github CI自动发版",{"type":7,"value":8,"toc":130},"minimark",[9,18,65,71,77,81,88,95,105,111,119,122],[10,11,12,13,17],"p",{},"介绍一款CI插件, 叫",[14,15,16],"code",{"code":16},"semantic-release",", 根据提交信息, 自动打tag后发布release",[19,20,21,34],"table",{},[22,23,24],"thead",{},[25,26,27,31],"tr",{},[28,29,30],"th",{},"提交类型",[28,32,33],{},"版本提升",[35,36,37,52],"tbody",{},[25,38,39,45],{},[40,41,42],"td",{},[14,43,44],{"code":44},"feat",[40,46,47,51],{},[48,49,50],"strong",{},"MINOR","(1.1.2 -> 1.2.0)",[25,53,54,59],{},[40,55,56],{},[14,57,58],{"code":58},"fix",[40,60,61,64],{},[48,62,63],{},"PATCH","(1.1.2 -> 1.1.3)",[10,66,67,68,70],{},"我们在生产环境经常需要发版, 所以",[14,69,16],{"code":16},"是比较好的选择, 无需我们手动打tag并发布",[72,73,74],"blockquote",{},[10,75,76],{},"不过需要注意的是, 需要对代码进行测试, 能够正常build的才能走自动化打包发版的流程",[78,79,80],"h2",{"id":80},"例子",[10,82,83,84,87],{},"下面用github发版",[14,85,86],{"code":86},"Go SDK","包为例子",[89,90,92],"h3",{"id":91},"releaseyml",[14,93,94],{"code":94},"release.yml",[96,97,103],"pre",{"className":98,"code":100,"language":101,"meta":102},[99],"language-yaml","name: Go SDK Release\n\non:\n  push:\n    branches:\n      - main\n\npermissions:\n  contents: write\n\njobs:\n  release:\n    runs-on: ubuntu-latest\n\n    steps:\n      # 拉代码\n      - name: Checkout\n        uses: actions\u002Fcheckout@v4\n        with:\n          fetch-depth: 0\n\n      # ---------- Go 环境 ----------\n      - name: Setup Go\n        uses: actions\u002Fsetup-go@v5\n        with:\n          go-version: '1.22'\n          cache: true\n\n      - name: Go mod tidy\n        run: go mod tidy\n\n      - name: Go build\n        run: go build .\u002F...\n\n      # ---------- Node 环境 ----------\n      - name: Setup Node\n        uses: actions\u002Fsetup-node@v4\n        with:\n          node-version: 20\n\n      # ---------- Semantic Release ----------\n      - name: Run semantic-release\n        env:\n          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n        run: npx semantic-release\n","yaml","",[14,104,100],{"__ignoreMap":102},[89,106,108],{"id":107},"releasercjson",[14,109,110],{"code":110},".releaserc.json",[96,112,117],{"className":113,"code":115,"language":116,"meta":102},[114],"language-json","{\n    \"branches\": [\n        \"main\"\n    ],\n    \"tagFormat\": \"v${version}\",\n    \"plugins\": [\n        \"@semantic-release\u002Fcommit-analyzer\",\n        \"@semantic-release\u002Frelease-notes-generator\",\n        \"@semantic-release\u002Fgithub\"\n    ]\n}\n","json",[14,118,115],{"__ignoreMap":102},[78,120,121],{"id":121},"具体仓库参考",[10,123,124],{},[125,126,127],"a",{"href":127,"rel":128},"https:\u002F\u002Fgithub.com\u002Fcodepzj\u002Fgo-lib",[129],"nofollow",{"title":102,"searchDepth":131,"depth":131,"links":132},4,[133,139],{"id":80,"depth":134,"text":80,"children":135},2,[136,138],{"id":91,"depth":137,"text":94},3,{"id":107,"depth":137,"text":110},{"id":121,"depth":134,"text":121},[141],"工程实践","2026-02-15","介绍如何通过 GitHub Actions 和 Semantic Release 自动生成版本号、Tag 与发布记录。",false,"md",null,{"slots":148},{},true,"\u002F2026\u002F02\u002Fgit-semantic-release",{"text":152,"minutes":153,"time":154,"words":155},"2 min read",1.13,67800,226,{"title":5,"description":143},{"loc":150},"posts\u002F2026\u002F02\u002Fgit-semantic-release",[160],"git","tech","2026-02-18","WpqOMjIuBzFU2ffTQuKXX2FKzpbeX4O1PSliOpaubp8",[165,170],{"title":166,"path":167,"stem":168,"date":169,"type":161,"children":-1},"git-filter-repo 清理敏感信息","\u002F2026\u002F01\u002Fgit-filter-repo","posts\u002F2026\u002F01\u002Fgit-filter-repo","2026-01-21",{"title":171,"path":172,"stem":173,"date":162,"type":161,"children":-1},"MySQL 表结构常用操作","\u002F2026\u002F02\u002Fmysql-dev-table","posts\u002F2026\u002F02\u002Fmysql-dev-table",1786037979471]