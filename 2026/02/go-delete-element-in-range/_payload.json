[{"data":1,"prerenderedAt":290},["ShallowReactive",2],{"content:\u002F2026\u002F02\u002Fgo-delete-element-in-range":3,"surround:\u002F2026\u002F02\u002Fgo-delete-element-in-range":279},{"id":4,"title":5,"body":6,"categories":258,"date":260,"description":261,"draft":262,"extension":263,"image":264,"meta":265,"navigation":267,"path":268,"permalink":264,"published":264,"readingTime":269,"recommend":264,"references":264,"seo":273,"sitemap":274,"stem":275,"tags":276,"type":277,"updated":260,"__hash__":278},"content\u002Fposts\u002F2026\u002F02\u002Fgo-delete-element-in-range.md","Go遍历时删除特定元素",{"type":7,"value":8,"toc":246},"minimark",[9,13,17,20,31,35,130,138,141,145,148,154,157,234,237,243],[10,11,12],"p",{},"我们都知道在 Go 语言中可以通过切片语法删除特定元素，但实际开发中，常见的写法其实是有问题的。",[14,15,16],"h2",{"id":16},"错误示例",[10,18,19],{},"下面这段 Go 代码表面上看起来没什么问题，但实际存在 bug：",[21,22,28],"pre",{"className":23,"code":25,"language":26,"meta":27},[24],"language-go","package main\n\nimport \"fmt\"\n\nfunc main() {\n\tm := []string{\"a\", \"b\", \"c\", \"d\"}\n\tfor i, v := range m {\n\t\tfmt.Println(\"len(m)\", len(m), v)\n\t\tif i == 1 {\n\t\t\tm = append(m[:i], m[i+1:]...)\n\t\t}\n\t}\n\tfmt.Println(\"m\", m)\n}\n","go","",[29,30,25],"code",{"__ignoreMap":27},[32,33,34],"h3",{"id":34},"数据流转解析",[36,37,38,94,127],"ul",{},[39,40,41,42],"li",{},"初始切片内容和索引如下：",[43,44,45,58],"table",{},[46,47,48],"thead",{},[49,50,51,55],"tr",{},[52,53,54],"th",{},"索引",[52,56,57],{},"值",[59,60,61,70,78,86],"tbody",{},[49,62,63,67],{},[64,65,66],"td",{},"0",[64,68,69],{},"a",[49,71,72,75],{},[64,73,74],{},"1",[64,76,77],{},"b",[49,79,80,83],{},[64,81,82],{},"2",[64,84,85],{},"c",[49,87,88,91],{},[64,89,90],{},"3",[64,92,93],{},"d",[39,95,96,97],{},"在遍历到 b 时（i==1），删除 b 这个元素，切片变为：",[43,98,99,107],{},[46,100,101],{},[49,102,103,105],{},[52,104,54],{},[52,106,57],{},[59,108,109,115,121],{},[49,110,111,113],{},[64,112,66],{},[64,114,69],{},[49,116,117,119],{},[64,118,74],{},[64,120,85],{},[49,122,123,125],{},[64,124,82],{},[64,126,93],{},[39,128,129],{},"剩下还有 2 次遍历，且都会输出 d，导致输出如下：",[21,131,136],{"className":132,"code":134,"language":135,"meta":27},[133],"language-text","len(m) 4 a\nlen(m) 4 b\nlen(m) 3 d\nlen(m) 3 d\nm [a c d]\n","text",[29,137,134],{"__ignoreMap":27},[10,139,140],{},"可以看到根本不会打印 c，也就是说循环过程中遗漏了一些元素。",[14,142,144],{"id":143},"正确做法倒序遍历","正确做法：倒序遍历",[10,146,147],{},"最优雅、推荐的做法是倒序遍历切片，然后删除元素。",[21,149,152],{"className":150,"code":151,"language":26,"meta":27},[24],"package main\n\nimport \"fmt\"\n\nfunc main() {\n\tm := []string{\"a\", \"b\", \"c\", \"d\"}\n\tfor i := len(m) - 1; i >= 0; i-- {\n\t\tfmt.Println(\"len(m)\", len(m), m[i])\n\t\tif i == 1 {\n\t\t\tm = append(m[:i], m[i+1:]...)\n\t\t}\n\t}\n\tfmt.Println(\"m\", m)\n}\n",[29,153,151],{"__ignoreMap":27},[32,155,156],{"id":156},"过程解析",[36,158,159,198,231],{},[39,160,161,162],{},"初始切片内容和索引：",[43,163,164,172],{},[46,165,166],{},[49,167,168,170],{},[52,169,54],{},[52,171,57],{},[59,173,174,180,186,192],{},[49,175,176,178],{},[64,177,66],{},[64,179,69],{},[49,181,182,184],{},[64,183,74],{},[64,185,77],{},[49,187,188,190],{},[64,189,82],{},[64,191,85],{},[49,193,194,196],{},[64,195,90],{},[64,197,93],{},[39,199,200,201],{},"从索引 3 开始遍历到 0，到 b 的时候（i==1），删除 b，切片变为：",[43,202,203,211],{},[46,204,205],{},[49,206,207,209],{},[52,208,54],{},[52,210,57],{},[59,212,213,219,225],{},[49,214,215,217],{},[64,216,66],{},[64,218,69],{},[49,220,221,223],{},[64,222,74],{},[64,224,85],{},[49,226,227,229],{},[64,228,82],{},[64,230,93],{},[39,232,233],{},"因为是倒序遍历，已经被遍历过的元素不会受影响，所以不会发生漏读。",[32,235,236],{"id":236},"最终输出",[21,238,241],{"className":239,"code":240,"language":135,"meta":27},[133],"len(m) 4 d\nlen(m) 4 c\nlen(m) 4 b\nlen(m) 3 a\nm [a c d]\n",[29,242,240],{"__ignoreMap":27},[10,244,245],{},"这种方式可以保证不会遗漏或重复读取元素，代码也更健壮。",{"title":27,"searchDepth":247,"depth":247,"links":248},4,[249,254],{"id":16,"depth":250,"text":16,"children":251},2,[252],{"id":34,"depth":253,"text":34},3,{"id":143,"depth":250,"text":144,"children":255},[256,257],{"id":156,"depth":253,"text":156},{"id":236,"depth":253,"text":236},[259],"Go语言","2026-02-20","Go遍历时候删除元素时候的坑，不能正序删除，不然会引起索引错位",false,"md",null,{"slots":266},{},true,"\u002F2026\u002F02\u002Fgo-delete-element-in-range",{"text":270,"minutes":250,"time":271,"words":272},"2 min read",120000,400,{"title":5,"description":261},{"loc":268},"posts\u002F2026\u002F02\u002Fgo-delete-element-in-range",[26],"tech","yHuycQ3iRsYzP4RY6OF8dieC81ps-iD0e7MRhX4Ka_s",[280,285],{"title":281,"path":282,"stem":283,"date":284,"type":277,"children":-1},"Golang中的优雅关闭与退出","\u002F2026\u002F02\u002Fgo-graceful-shutdown","posts\u002F2026\u002F02\u002Fgo-graceful-shutdown","2026-02-19",{"title":286,"path":287,"stem":288,"date":289,"type":277,"children":-1},"MySQL 主从复制搭建与配置","\u002F2026\u002F02\u002Fmysql-master-slave-copy","posts\u002F2026\u002F02\u002Fmysql-master-slave-copy","2026-02-27",1786037979318]