[{"data":1,"prerenderedAt":285},["ShallowReactive",2],{"content:\u002F2026\u002F02\u002Fgo-graceful-shutdown":3,"surround:\u002F2026\u002F02\u002Fgo-graceful-shutdown":274},{"id":4,"title":5,"body":6,"categories":252,"date":254,"description":255,"draft":256,"extension":257,"image":258,"meta":259,"navigation":261,"path":262,"permalink":258,"published":258,"readingTime":263,"recommend":258,"references":258,"seo":268,"sitemap":269,"stem":270,"tags":271,"type":272,"updated":254,"__hash__":273},"content\u002Fposts\u002F2026\u002F02\u002Fgo-graceful-shutdown.md","Golang中的优雅关闭与退出",{"type":7,"value":8,"toc":242},"minimark",[9,13,16,29,33,44,51,54,58,125,132,135,145,177,182,185,191,194,205,211,219,233,236],[10,11,12],"p",{},"在golang当中，我们经常需要在服务器关闭的那一瞬间去做一些操作",[10,14,15],{},"比如：",[17,18,19,23,26],"ul",{},[20,21,22],"li",{},"日志刷盘",[20,24,25],{},"关闭基础设施连接",[20,27,28],{},"销毁goroutine后台协程",[30,31,32],"h2",{"id":32},"优雅关闭和退出",[34,35,41],"pre",{"className":36,"code":38,"language":39,"meta":40},[37],"language-go","\u002F\u002F 优雅关闭和退出\nquit := make(chan os.Signal, 1)\nsignal.Notify(quit, syscall.SIGINT, syscall.SIGTERM)\n","go","",[42,43,38],"code",{"__ignoreMap":40},[10,45,46,47,50],{},"这段代码的含义就是，创建一个监听系统信号的channel，在系统退出的时刻会向 ",[42,48,49],{"code":49},"quit"," 发送一个信号",[10,52,53],{},"这段代码主要监听两个信号，也是业界中常用的两个信号",[55,56,57],"h3",{"id":57},"对应的信号表格",[59,60,61,80],"table",{},[62,63,64],"thead",{},[65,66,67,71,74,77],"tr",{},[68,69,70],"th",{},"信号",[68,72,73],{},"来源",[68,75,76],{},"程序是否可捕获",[68,78,79],{},"常见用途",[81,82,83,98,111],"tbody",{},[65,84,85,89,92,95],{},[86,87,88],"td",{},"SIGINT",[86,90,91],{},"Ctrl+C",[86,93,94],{},"可以",[86,96,97],{},"本地手动停止",[65,99,100,103,106,108],{},[86,101,102],{},"SIGTERM",[86,104,105],{},"kill \u002F 容器停止 \u002F k8s pod 杀死",[86,107,94],{},[86,109,110],{},"优雅关闭",[65,112,113,116,119,122],{},[86,114,115],{},"SIGKILL",[86,117,118],{},"kill -9",[86,120,121],{},"不可以",[86,123,124],{},"强制杀死",[10,126,127,128,131],{},"不过需要注意的是，主要针对人为的",[42,129,130],{"code":130},"Ctrl + C","、进程被kill、docker容器被kill以及k8s pod被kill的信号",[55,133,134],{"id":134},"监测不到的signal",[10,136,137],{},[138,139,140,141,144],"strong",{},"vscode中的",[42,142,143],{"code":143},"dlv debug",", 直接 detach 或调用 ptrace 终止进程。",[17,146,147],{},[20,148,149,150,158,161,162,174,176],{},"真实结构是：",[34,151,156],{"className":152,"code":154,"language":155},[153],"language-text","dlv (调试器进程)\n   └── 被调试的 Go 进程\n","text",[42,157,154],{"__ignoreMap":40},[159,160],"br",{},"而且：",[17,163,164,171],{},[20,165,166,167,170],{},"dlv 通过 ",[138,168,169],{},"ptrace"," 控制 Go 进程",[20,172,173],{},"Go 进程是被“trace”的状态",[159,175],{},"暂停杀的是dlv调试程序，go进程无法监听到信号就被杀死了",[10,178,179],{},[138,180,181],{},"使用air的默认配置是无法触发优雅退出的",[10,183,184],{},"实际结构是：",[34,186,189],{"className":187,"code":188,"language":155,"meta":40},[153],"air 进程\n   └── 你的 Go 程序\n",[42,190,188],{"__ignoreMap":40},[10,192,193],{},"和 dlv 不同的是：",[17,195,196,199,202],{},[20,197,198],{},"air 不使用 ptrace",[20,200,201],{},"它只是一个普通父进程",[20,203,204],{},"通过 fork\u002Fexec 启动你的程序",[10,206,207,210],{},[138,208,209],{},"优雅退出","应该这样做",[34,212,217],{"className":213,"code":215,"language":216,"meta":40},[214],"language-toml","[build]\n  kill_delay = \"5s\"\n  send_interrupt = true\n","toml",[42,218,215],{"__ignoreMap":40},[10,220,221,222,225,226,229,230,232],{},"在",[42,223,224],{"code":224},"build","选项后修改这两个配置项，",[42,227,228],{"code":228},"send_interrupt","指的是给子进程发",[42,231,130],{"code":130},"的退出信号，并预留5s的时间给子进程。",[30,234,235],{"id":235},"示例代码",[34,237,240],{"className":238,"code":239,"language":39,"meta":40},[37],"func (a *App) Start() {\n\t\u002F\u002F 优雅关闭和退出\n\tquit := make(chan os.Signal, 1)\n\tsignal.Notify(quit, syscall.SIGINT, syscall.SIGTERM)\n\n\tgo func() {\n\t\ta.engine.Run(fmt.Sprintf(\":%d\", conf.GetGlobalConfig().Server.Port))\n\t}()\n\n\t\u003C-quit\n\n\tlog.Println(\"exit wschat\")\n}\n",[42,241,239],{"__ignoreMap":40},{"title":40,"searchDepth":243,"depth":243,"links":244},4,[245,251],{"id":32,"depth":246,"text":32,"children":247},2,[248,250],{"id":57,"depth":249,"text":57},3,{"id":134,"depth":249,"text":134},{"id":235,"depth":246,"text":235},[253],"Go语言","2026-02-19","Golang中的优雅关闭与退出，去做一些日志刷盘、关闭基础设施和goroutine连接的操作。",false,"md",null,{"slots":260},{},true,"\u002F2026\u002F02\u002Fgo-graceful-shutdown",{"text":264,"minutes":265,"time":266,"words":267},"3 min read",2.26,135600,452,{"title":5,"description":255},{"loc":262},"posts\u002F2026\u002F02\u002Fgo-graceful-shutdown",[39],"tech","bYAIQ6DbzI867HNxEMBsG4eNTMkxDog0rO9vvwUjmkY",[275,280],{"title":276,"path":277,"stem":278,"date":279,"type":272,"children":-1},"MySQL 用户与权限管理","\u002F2026\u002F02\u002Fmysql-dev-user","posts\u002F2026\u002F02\u002Fmysql-dev-user","2026-02-18",{"title":281,"path":282,"stem":283,"date":284,"type":272,"children":-1},"Go遍历时删除特定元素","\u002F2026\u002F02\u002Fgo-delete-element-in-range","posts\u002F2026\u002F02\u002Fgo-delete-element-in-range","2026-02-20",1786037979391]