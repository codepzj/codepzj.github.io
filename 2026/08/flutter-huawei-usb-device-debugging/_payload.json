[{"data":1,"prerenderedAt":805},["ShallowReactive",2],{"content:\u002F2026\u002F08\u002Fflutter-huawei-usb-device-debugging":3,"surround:\u002F2026\u002F08\u002Fflutter-huawei-usb-device-debugging":801},{"id":4,"title":5,"body":6,"categories":773,"date":775,"description":776,"draft":777,"extension":778,"image":779,"meta":780,"navigation":782,"path":783,"permalink":779,"published":779,"readingTime":784,"recommend":779,"references":779,"seo":789,"sitemap":790,"stem":791,"tags":792,"type":798,"updated":799,"__hash__":800},"content\u002Fposts\u002F2026\u002F08\u002Fflutter-huawei-usb-device-debugging.md","macOS 使用华为手机调试 Flutter：ADB 设备为空排查",{"type":7,"value":8,"toc":756},"minimark",[9,13,29,38,43,46,102,113,116,119,138,141,152,155,159,170,182,185,194,197,204,207,213,224,231,238,245,248,254,257,262,268,274,279,283,286,319,323,326,332,335,349,352,355,358,372,381,385,388,448,457,460,464,467,474,477,484,487,490,556,559,566,571,577,580,583,600,603,610,613,617,620,627,630,637,640,647,650,656,659,665,668,722,725,730,736,753],[10,11,12],"p",{},"Flutter Android 项目除了使用模拟器，也可以直接连接 Android 手机进行真机调试。真机能够更准确地验证相机、通知、定位、蓝牙、性能以及不同厂商系统的兼容性。",[10,14,15,16,20,21,24,25,28],{},"本文记录一次在 macOS 上连接华为手机运行 Flutter 项目的完整排障过程：最初 ",[17,18,19],"code",{"code":19},"adb devices"," 一直为空，最终将手机的 USB 模式切换为 ",[17,22,23],{"code":23},"MTP"," 后成功识别设备，并通过 ",[17,26,27],{"code":27},"flutter run"," 启动项目。",[10,30,31,32,37],{},"如果 Flutter、Android Studio 和 Android SDK 尚未安装，可以先参考",[33,34,36],"a",{"href":35},"\u002F2026\u002F08\u002Fflutter-macos-environment-setup","macOS 搭建 Flutter Android 与 iOS 开发环境","。",[39,40,42],"h2",{"id":41},"无线配对还是-usb-连接","无线配对还是 USB 连接",[10,44,45],{},"Android 11 及以上版本通常支持无线调试，可以通过配对码或二维码连接 Android Studio。无线调试适合日常开发，但首次连接时，USB 仍然是最稳定、最容易判断问题所在的方式。",[47,48,49,65],"table",{},[50,51,52],"thead",{},[53,54,55,59,62],"tr",{},[56,57,58],"th",{},"连接方式",[56,60,61],{},"优点",[56,63,64],{},"注意事项",[66,67,68,80,91],"tbody",{},[53,69,70,74,77],{},[71,72,73],"td",{},"USB 数据线",[71,75,76],{},"稳定、延迟低、排障简单",[71,78,79],{},"线材和接口必须支持数据传输",[53,81,82,85,88],{},[71,83,84],{},"二维码无线配对",[71,86,87],{},"不需要长期插线",[71,89,90],{},"手机和 Mac 通常需要位于同一局域网",[53,92,93,96,99],{},[71,94,95],{},"ADB TCP\u002FIP",[71,97,98],{},"可手动指定 IP 连接",[71,100,101],{},"首次启用时经常仍需要 USB",[103,104,107],"alert",{"title":105,"type":106},"建议首次连接使用 USB","info",[10,108,109,110,112],{},"如果 ",[17,111,19],{"code":19}," 完全为空，先通过 USB 建立一条可靠的数据连接。确认真机调试正常后，再切换到无线调试会更容易排查问题。",[39,114,115],{"id":115},"使用二维码无线配对",[10,117,118],{},"如果华为手机的“无线调试”页面提供“使用二维码配对设备”，可以尝试以下流程。",[120,121,122,126,129,132,135],"ol",{},[123,124,125],"li",{},"Mac 和手机连接同一个 Wi-Fi。",[123,127,128],{},"手机进入“设置 → 系统和更新 → 开发人员选项 → 无线调试”。",[123,130,131],{},"开启无线调试，选择“使用二维码配对设备”。",[123,133,134],{},"Android Studio 打开“Device Manager → Pair Devices Using Wi-Fi → Pair using QR code”。",[123,136,137],{},"使用无线调试页面提供的扫码功能扫描二维码。",[10,139,140],{},"配对完成后执行：",[142,143,150],"pre",{"className":144,"code":146,"filename":147,"language":148,"meta":149},[145],"language-bash","adb devices -l\nflutter devices\n","检查无线设备","bash","",[17,151,146],{"__ignoreMap":149},[10,153,154],{},"不同 EMUI 或 HarmonyOS 版本提供的选项可能不同。如果手机没有二维码配对入口，可以使用配对码，或者直接使用 USB 连接。",[39,156,158],{"id":157},"使用配对码连接无线-adb","使用配对码连接无线 ADB",[10,160,161,162,165,166,169],{},"Android 11 及以上版本的无线调试分为两个步骤：先使用 ",[17,163,164],{"code":164},"adb pair"," 完成配对，再使用 ",[17,167,168],{"code":168},"adb connect"," 建立连接。配对通常只需要执行一次，而重新开启无线调试或网络发生变化后，可能需要再次执行连接。",[103,171,174],{"title":172,"type":173},"配对端口和连接端口不同","warning",[10,175,176,178,179,181],{},[17,177,164],{"code":164}," 使用“使用配对码配对设备”页面显示的配对端口；",[17,180,168],{"code":168}," 使用“无线调试”主页面显示的 IP 地址和端口。不要将两个端口混用。",[10,183,184],{},"首先在手机中进入“设置 → 系统和更新 → 开发人员选项 → 无线调试”，点击“使用配对码配对设备”。页面会显示 IP 地址、配对端口和六位配对码，例如：",[142,186,192],{"className":187,"code":189,"filename":190,"language":191,"meta":149},[188],"language-text","IP 地址：192.168.0.106\n配对端口：45333\n配对码：123456\n","无线配对信息","text",[17,193,189],{"__ignoreMap":149},[10,195,196],{},"在 Mac 中执行：",[142,198,202],{"className":199,"code":200,"filename":201,"language":148,"meta":149},[145],"adb pair 192.168.0.106:45333\n","配对无线设备",[17,203,200],{"__ignoreMap":149},[10,205,206],{},"根据提示输入手机显示的配对码。出现以下信息说明配对成功：",[142,208,211],{"className":209,"code":210,"language":191,"meta":149},[188],"Successfully paired to 192.168.0.106:45333\n",[17,212,210],{"__ignoreMap":149},[10,214,215,216,220,221,223],{},"此时只是完成了 ",[217,218,219],"strong",{},"Pair（配对）","，设备不一定会立即出现在 ",[17,222,19],{"code":19}," 中。返回手机的“无线调试”主页面，查看当前的“IP 地址和端口”，例如：",[142,225,229],{"className":226,"code":227,"filename":228,"language":191,"meta":149},[188],"IP 地址和端口：192.168.0.106:39175\n","无线连接信息",[17,230,227],{"__ignoreMap":149},[10,232,233,234,237],{},"这里的 ",[17,235,236],{"code":236},"39175"," 是连接端口。使用它执行：",[142,239,243],{"className":240,"code":241,"filename":242,"language":148,"meta":149},[145],"adb connect 192.168.0.106:39175\n","连接无线设备",[17,244,241],{"__ignoreMap":149},[10,246,247],{},"连接成功后会看到：",[142,249,252],{"className":250,"code":251,"language":191,"meta":149},[188],"connected to 192.168.0.106:39175\n",[17,253,251],{"__ignoreMap":149},[10,255,256],{},"最后检查 ADB 和 Flutter 是否已经识别设备：",[142,258,260],{"className":259,"code":146,"filename":147,"language":148,"meta":149},[145],[17,261,146],{"__ignoreMap":149},[10,263,264,267],{},[17,265,266],{"code":266},"adb devices -l"," 应该出现类似结果：",[142,269,272],{"className":270,"code":271,"language":191,"meta":149},[188],"192.168.0.106:39175 device product:... model:... device:...\n",[17,273,271],{"__ignoreMap":149},[10,275,109,276,278],{},[17,277,168],{"code":168}," 提示连接失败，确认手机和 Mac 位于同一个局域网，并重新查看无线调试主页面中的连接端口。无线调试关闭后重新开启时，连接端口可能发生变化。",[39,280,282],{"id":281},"使用-usb-连接华为手机","使用 USB 连接华为手机",[10,284,285],{},"完整连接流程可以分为四步：",[287,288,289,292,295,298,301,304,307,310],"timeline",{},[10,290,291],{},"{1. 开启开发者选项}",[10,293,294],{},"连续点击版本号，进入开发人员选项。",[10,296,297],{},"{2. 开启 USB 调试}",[10,299,300],{},"允许当前 Mac 通过 ADB 调试手机。",[10,302,303],{},"{3. 建立 USB 数据连接}",[10,305,306],{},"使用支持数据传输的线材，并选择 MTP 模式。",[10,308,309],{},"{4. 运行 Flutter 项目}",[10,311,312,313,316,317,37],{},"确认 ADB 设备状态为 ",[17,314,315],{"code":315},"device","，再执行 ",[17,318,27],{"code":27},[320,321,322],"h3",{"id":322},"开启开发者选项",[10,324,325],{},"在华为手机中进入“设置 → 关于手机”，连续点击“版本号”7 次。系统提示已进入开发者模式后，返回：",[142,327,330],{"className":328,"code":329,"language":191,"meta":149},[188],"设置\n└── 系统和更新\n    └── 开发人员选项\n",[17,331,329],{"__ignoreMap":149},[10,333,334],{},"开启以下选项：",[336,337,338,343],"ul",{},[123,339,340],{},[17,341,342],{"code":342},"USB 调试",[123,344,345,348],{},[17,346,347],{"code":347},"仅充电模式下允许 ADB 调试","，如果系统提供该选项",[320,350,351],{"id":351},"使用支持数据传输的线材",[10,353,354],{},"手机能够充电，不代表 USB 数据连接一定正常。部分数据线只有供电能力，部分扩展坞的 USB-C 接口也可能只是 PD 充电口。",[10,356,357],{},"排障时建议：",[336,359,360,363,366,369],{},[123,361,362],{},"手机保持解锁状态。",[123,364,365],{},"使用明确支持数据传输的 USB 线。",[123,367,368],{},"暂时绕过显示器、转接器和扩展坞。",[123,370,371],{},"将手机直接连接到 Mac 的 USB 接口。",[103,373,375],{"title":374,"type":173},"充电正常不代表数据正常",[10,376,377,378,380],{},"当 ",[17,379,19],{"code":19}," 完全为空时，最常见的原因不是 Flutter，而是线材、扩展坞接口或手机的 USB 模式没有建立数据连接。",[320,382,384],{"id":383},"选择-mtp-模式","选择 MTP 模式",[10,386,387],{},"连接手机后，下拉通知栏，打开 USB 用途设置。华为手机可能显示以下选项：",[47,389,390,403],{},[50,391,392],{},[53,393,394,397,400],{},[56,395,396],{},"模式",[56,398,399],{},"用途",[56,401,402],{},"调试建议",[66,404,405,415,426,437],{},[53,406,407,409,412],{},[71,408,23],{},[71,410,411],{},"文件传输",[71,413,414],{},"优先选择，确保进入 USB 数据连接模式",[53,416,417,420,423],{},[71,418,419],{},"PTP",[71,421,422],{},"照片传输",[71,424,425],{},"主要用于导入照片",[53,427,428,431,434],{},[71,429,430],{},"RNDIS",[71,432,433],{},"USB 网络共享",[71,435,436],{},"将手机作为网络设备使用",[53,438,439,442,445],{},[71,440,441],{},"MIDI",[71,443,444],{},"MIDI 乐器和音频设备",[71,446,447],{},"与 Android 调试无关",[10,449,450,451,453,454,456],{},"本次连接中，手机最初只能充电，",[17,452,19],{"code":19}," 没有任何设备。选择 ",[17,455,23],{"code":23}," 后，Mac 收到了 USB 数据信号，手机随即弹出 USB 调试授权窗口。",[10,458,459],{},"在授权窗口中勾选“始终允许使用这台计算机”，然后点击“允许”。",[39,461,463],{"id":462},"检查-adb-连接状态","检查 ADB 连接状态",[10,465,466],{},"首先执行：",[142,468,472],{"className":469,"code":470,"filename":471,"language":148,"meta":149},[145],"adb devices -l\n","检查 ADB 设备",[17,473,470],{"__ignoreMap":149},[10,475,476],{},"如果设备列表为空，可以重启 ADB 服务：",[142,478,482],{"className":479,"code":480,"filename":481,"language":148,"meta":149},[145],"adb kill-server\nadb start-server\nadb devices -l\n","重启 ADB",[17,483,480],{"__ignoreMap":149},[10,485,486],{},"ADB 服务正常启动，但列表仍然为空时，说明 Mac 尚未识别到手机的 USB 调试接口。此时应继续检查线材、接口和 USB 模式，而不是重新安装 Flutter。",[10,488,489],{},"常见状态如下：",[47,491,492,505],{},[50,493,494],{},[53,495,496,499,502],{},[56,497,498],{},"输出状态",[56,500,501],{},"含义",[56,503,504],{},"处理方式",[66,506,507,518,531,544],{},[53,508,509,512,515],{},[71,510,511],{},"完全为空",[71,513,514],{},"没有建立 USB 数据连接",[71,516,517],{},"切换 MTP、换线、换接口、绕过扩展坞",[53,519,520,525,528],{},[71,521,522],{},[17,523,524],{"code":524},"unauthorized",[71,526,527],{},"手机尚未授权当前 Mac",[71,529,530],{},"解锁手机并允许 USB 调试",[53,532,533,538,541],{},[71,534,535],{},[17,536,537],{"code":537},"offline",[71,539,540],{},"ADB 会话异常",[71,542,543],{},"重插数据线并重启 ADB",[53,545,546,550,553],{},[71,547,548],{},[17,549,315],{"code":315},[71,551,552],{},"连接正常",[71,554,555],{},"可以运行 Flutter 项目",[10,557,558],{},"本次成功连接后，输出如下：",[142,560,564],{"className":561,"code":562,"filename":563,"language":191,"meta":149},[188],"List of devices attached\nANYXVB4C04002519  device usb:18022400X product:BVL-AN00 model:BVL_AN00 device:HNBVL-AN00 transport_id:2\n","成功识别华为手机",[17,565,562],{"__ignoreMap":149},[10,567,568,569,37],{},"其中最重要的是设备编号后的状态为 ",[17,570,315],{"code":315},[103,572,574],{"title":573,"type":106},"macOS 通常不需要安装华为驱动",[10,575,576],{},"macOS 使用 Android Platform-Tools 中的 ADB 与手机通信，一般不需要额外安装 Windows 平台常见的手机 USB 驱动。",[39,578,579],{"id":579},"没有出现授权弹窗怎么办",[10,581,582],{},"如果已经选择 MTP，但手机没有弹出 USB 调试授权窗口，可以依次执行：",[120,584,585,588,591,594,597],{},[123,586,587],{},"进入“开发人员选项”。",[123,589,590],{},"点击“撤销 USB 调试授权”。",[123,592,593],{},"关闭并重新开启 USB 调试。",[123,595,596],{},"将“默认 USB 配置”设置为文件传输或 MTP。",[123,598,599],{},"拔掉数据线并重新连接。",[10,601,602],{},"还可以检查 macOS 是否在 USB 总线上识别到手机：",[142,604,608],{"className":605,"code":606,"filename":607,"language":148,"meta":149},[145],"system_profiler SPUSBDataType\n","检查 macOS USB 设备",[17,609,606],{"__ignoreMap":149},[10,611,612],{},"如果这里也完全看不到手机，优先更换线材或连接接口。",[39,614,616],{"id":615},"使用-flutter-运行项目","使用 Flutter 运行项目",[10,618,619],{},"ADB 状态正常后，检查 Flutter 是否能够发现设备：",[142,621,625],{"className":622,"code":623,"filename":624,"language":148,"meta":149},[145],"flutter devices\n","检查 Flutter 设备",[17,626,623],{"__ignoreMap":149},[10,628,629],{},"进入 Flutter 项目目录并运行：",[142,631,635],{"className":632,"code":633,"filename":634,"language":148,"meta":149},[145],"flutter run\n","运行到默认设备",[17,636,633],{"__ignoreMap":149},[10,638,639],{},"如果同时连接了多个模拟器或真机，可以指定设备编号：",[142,641,645],{"className":642,"code":643,"filename":644,"language":148,"meta":149},[145],"flutter run -d ANYXVB4C04002519\n","指定华为手机",[17,646,643],{"__ignoreMap":149},[10,648,649],{},"正常情况下会看到：",[142,651,654],{"className":652,"code":653,"language":191,"meta":149},[188],"Launching lib\u002Fmain.dart on BVL AN00 in debug mode...\nRunning Gradle task 'assembleDebug'...\n",[17,655,653],{"__ignoreMap":149},[10,657,658],{},"第一次运行 Android 项目通常比较慢，因为 Gradle 需要下载依赖、编译 Android 工程并生成 Debug APK。构建完成后会继续安装应用并同步文件：",[142,660,663],{"className":661,"code":662,"language":191,"meta":149},[188],"Installing build\u002Fapp\u002Foutputs\u002Fflutter-apk\u002Fapp-debug.apk...\nSyncing files to device...\n",[17,664,662],{"__ignoreMap":149},[10,666,667],{},"运行期间可以使用以下快捷键：",[47,669,670,680],{},[50,671,672],{},[53,673,674,677],{},[56,675,676],{},"按键",[56,678,679],{},"作用",[66,681,682,692,702,712],{},[53,683,684,689],{},[71,685,686],{},[17,687,688],{"code":688},"r",[71,690,691],{},"热重载",[53,693,694,699],{},[71,695,696],{},[17,697,698],{"code":698},"R",[71,700,701],{},"热重启",[53,703,704,709],{},[71,705,706],{},[17,707,708],{"code":708},"h",[71,710,711],{},"查看全部命令",[53,713,714,719],{},[71,715,716],{},[17,717,718],{"code":718},"q",[71,720,721],{},"停止调试",[39,723,724],{"id":724},"快速排障顺序",[10,726,377,727,729],{},[17,728,19],{"code":19}," 没有显示华为手机时，按照下面的顺序排查通常最快：",[142,731,734],{"className":732,"code":733,"language":191,"meta":149},[188],"adb devices 为空\n├── 手机是否解锁\n├── USB 调试是否开启\n├── 是否选择 MTP\u002F文件传输\n├── 是否弹出并允许 USB 调试授权\n├── 数据线是否支持数据传输\n├── 是否绕过扩展坞直接连接 Mac\n└── 重启 ADB 后再次检测\n",[17,735,733],{"__ignoreMap":149},[103,737,740],{"title":738,"type":739},"最终判断标准","tip",[10,741,742,743,745,746,748,749,752],{},"只要 ",[17,744,266],{"code":266}," 中设备状态为 ",[17,747,315],{"code":315},"，并且 ",[17,750,751],{"code":751},"flutter devices"," 能看到手机，就说明 Flutter 真机调试环境已经连接完成。",[10,754,755],{},"有线调试期间手机会同时充电，这是 USB 连接的正常行为。macOS 没有通用且可靠的方式在保持 ADB 数据连接的同时关闭供电。",{"title":149,"searchDepth":757,"depth":757,"links":758},4,[759,761,762,763,769,770,771,772],{"id":41,"depth":760,"text":42},2,{"id":115,"depth":760,"text":115},{"id":157,"depth":760,"text":158},{"id":281,"depth":760,"text":282,"children":764},[765,767,768],{"id":322,"depth":766,"text":322},3,{"id":351,"depth":766,"text":351},{"id":383,"depth":766,"text":384},{"id":462,"depth":760,"text":463},{"id":579,"depth":760,"text":579},{"id":615,"depth":760,"text":616},{"id":724,"depth":760,"text":724},[774],"移动开发","2026-08-04","记录在 macOS 上连接华为 Android 真机运行 Flutter 项目的完整过程，包含 ADB 无线配对与连接、USB 调试、MTP 模式、adb devices 为空及首次 Gradle 构建排查。",false,"md",null,{"slots":781},{},true,"\u002F2026\u002F08\u002Fflutter-huawei-usb-device-debugging",{"text":785,"minutes":786,"time":787,"words":788},"12 min read",11.1,666000,2220,{"title":5,"description":776},{"loc":783},"posts\u002F2026\u002F08\u002Fflutter-huawei-usb-device-debugging",[793,794,795,796,797],"Flutter","Android","ADB","华为","macOS","tech","2026-08-06","fsC7E4tT5B66sGUg8_5EeIIhLwF8y9-b5OIMCZvIOws",[802,779],{"title":36,"path":35,"stem":803,"date":804,"type":798,"children":-1},"posts\u002F2026\u002F08\u002Fflutter-macos-environment-setup","2026-08-02",1786037977958]